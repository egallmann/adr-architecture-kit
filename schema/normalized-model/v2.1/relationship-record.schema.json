{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/normalized-model/v2.1/relationship-record.schema.json",
  "title": "Relationship Record v2.1",
  "oneOf": [
    {
      "type": "object",
      "required": ["record_kind", "id", "alias_id", "alias_name", "relationship_type", "from_entity_id", "to_entity_id", "canonical_source_ref"],
      "properties": {
        "record_kind": {"const": "canonical"},
        "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "alias_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{4}$"},
        "alias_name": {"type": "string", "minLength": 3, "maxLength": 96},
        "relationship_type": {"type": "string"},
        "from_entity_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "to_entity_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "source_owner_id": {"type": ["string", "null"]},
        "source_pointer": {"type": ["string", "null"]},
        "provenance_classification": {"enum": ["explicit", "derived", "heuristic"]},
        "evidence": {"type": "array"},
        "canonical_source_ref": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "extension": {"$ref": "normalized-entity.schema.json#/properties/extension"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["record_kind", "relationship_id", "assertion_id", "relationship_type", "from_entity_id", "to_entity_id", "provenance_classification", "canonical_source_ref"],
      "properties": {
        "record_kind": {"const": "compatibility"},
        "relationship_id": {"type": "string"},
        "assertion_id": {"type": "string", "pattern": "^asrt-[0-9a-f]{64}$"},
        "relationship_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "from_entity_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "to_entity_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "source_owner_id": {"type": ["string", "null"]},
        "source_pointer": {"type": ["string", "null"]},
        "provenance_classification": {"enum": ["explicit", "derived", "heuristic"]},
        "evidence": {"type": "array"},
        "canonical_source_ref": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  ]
}
