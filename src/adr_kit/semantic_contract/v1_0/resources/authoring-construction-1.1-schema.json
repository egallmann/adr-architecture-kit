        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource_member"
          }
        }
      },
      "additionalProperties": false
    },
    "exact_cec10_closure": {
      "type": "object",
      "required": [
        "family",
        "version",
        "resources"
      ],
      "properties": {
        "family": {
          "const": "custom-entity"
        },
        "version": {
          "const": "1.0"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource_member"
          }
        }
      },
      "additionalProperties": false
    }
  }
