{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adr-kit:governance-design:lifecycle-precedence:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "governing_adr_id",
    "activation",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "semantic-contract-lifecycle-precedence"
    },
    "governing_adr_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "activation": {
      "const": "authenticated_acceptance_only"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "original",
          "replacement",
          "applicability",
          "effect",
          "retained"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LC40-[0-9]{2}$"
          },
          "original": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adr_id",
              "member_id",
              "member_alias",
              "field",
              "anchor",
              "anchor_digest"
            ],
            "properties": {
              "adr_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "member_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "member_alias": {
                "type": "string",
                "pattern": "^(DEC|INV)-[0-9]{4}$"
              },
              "field": {
                "enum": [
                  "rationale",
                  "statement"
                ]
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "anchor_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "replacement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adr_id",
              "member_id",
              "requirement"
            ],
            "properties": {
              "adr_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "member_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "requirement": {
                "enum": [
                  "DEC-9023",
                  "DEC-9026"
                ]
              }
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "authority_scope",
              "promotion_state",
              "excludes_released"
            ],
            "properties": {
              "topic": {
                "enum": [
                  "snapshot_identity",
                  "candidate_version_finality",
                  "candidate_selection",
                  "prototype_retention"
                ]
              },
              "authority_scope": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "family",
                    "versions"
                  ],
                  "properties": {
                    "family": {
                      "enum": [
                        "architecture-interpretation",
                        "authoring-construction",
                        "normalized-model"
                      ]
                    },
                    "versions": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "1.1",
                          "1.2",
                          "1.3",
                          "1.4",
                          "1.5",
                          "2.5"
                        ]
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "promotion_state": {
                "const": "unreleased_after_explicit_correction"
              },
              "excludes_released": {
                "const": true
              }
            }
          },
          "effect": {
            "const": "replace_mapped_policy_only"
          },
          "retained": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
