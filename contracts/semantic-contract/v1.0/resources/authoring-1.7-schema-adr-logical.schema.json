{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/authoring/v1.7/adr-logical.schema.json",
  "title": "Logical ADR Schema (authoring v1.7)",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.7"}, "adr_type": {"const": "logical"},
    "id": {"$ref": "types.schema.json#/definitions/uuid_v7"}, "alias_id": {"type": "string", "pattern": "^ADR-(L|V)-[0-9]{4}$"}, "alias_name": {"$ref": "types.schema.json#/definitions/alias_name"},
    "title": {"type": "string", "minLength": 5, "maxLength": 200}, "status": {"$ref": "types.schema.json#/definitions/status"}, "created_date": {"$ref": "types.schema.json#/definitions/iso_date"}, "modified_date": {"$ref": "types.schema.json#/definitions/iso_date"}, "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "domains": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "array", "items": {"type": "string"}}, "related_adrs": {"type": "array", "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "supersedes": {"type": "array", "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "superseded_by": {"$ref": "types.schema.json#/definitions/uuid_v7"}, "projection_signals": {"type": "array", "items": {"type": "string"}},
    "ownership": {"type": "object", "additionalProperties": false, "properties": {"architecture_authority": {"type": "string"}, "implementation_owners": {"type": "array", "items": {"type": "string"}}}}, "governance": {"type": "object", "additionalProperties": false, "properties": {"implementation_authority": {"enum": ["none", "advisory", "implementation_authoritative"]}, "approved_by": {"type": "string"}, "approved_date": {"type": "string"}}},
    "context": {"type": "string"}, "vision_category": {"type": "boolean"}, "promotable_to_logical": {"type": "boolean"},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "adr-common.schema.json#/definitions/decision"}},
    "capabilities": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/capability"}},
    "architectural_boundaries": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/boundary"}},
    "contracts": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/contract"}},
    "invariants": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/invariant"}},
    "gaps": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/gap"}},
    "normative_propositions": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/normative_proposition"}},
    "evidence_expectations": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/evidence_expectation"}},
    "extension_entities": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/custom_entity"}},
    "extension_relationships": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/custom_relationship"}}
  },
  "required": ["schema_version", "adr_type", "id", "alias_id", "alias_name", "title", "status", "created_date", "authors", "context", "decisions"],
  "additionalProperties": false
}
