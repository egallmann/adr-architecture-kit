{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/workspace-attribution-federation.schema.json",
  "title": "Workspace Attribution Federation",
  "type": "object",
  "required": ["schema_version", "type", "generated_at", "qualified_adrs", "homonym_groups"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "type": {"const": "workspace_attribution_federation"},
    "generated_at": {"type": "string"},
    "qualified_adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "qualified_id",
          "bare_id",
          "corpus_scope",
          "title",
          "homonym_group",
          "embodiment_count",
          "records_from"
        ],
        "properties": {
          "qualified_id": {"type": "string"},
          "bare_id": {"type": "string"},
          "corpus_scope": {"type": "string"},
          "title": {"type": "string"},
          "homonym_group": {"type": "string"},
          "embodiment_count": {"type": "integer", "minimum": 0},
          "records_from": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          }
        }
      }
    },
    "homonym_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bare_id", "qualified_ids", "collision_kind"],
        "properties": {
          "bare_id": {"type": "string"},
          "qualified_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 2
          },
          "collision_kind": {
            "type": "string",
            "enum": ["independent_decisions"]
          }
        }
      }
    }
  }
}
