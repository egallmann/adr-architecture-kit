{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/contracts/semantic-contract/v1.0/semantic-contract-version.schema.json",
  "title": "ADR-Kit immutable semantic contract version",
  "description": "Closed, fingerprinted semantic identity. Lifecycle and catalog policy are intentionally outside this definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticContractFamily",
    "semanticContractVersion",
    "fingerprintScheme",
    "resourceManifest",
    "frozenNormativeConformanceResources",
    "semanticContractFingerprint"
  ],
  "properties": {
    "semanticContractFamily": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semanticContractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "fingerprintScheme": {
      "const": "scf:v1:sha256"
    },
    "resourceManifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "resource-manifest-entry.schema.json"}
    },
    "frozenNormativeConformanceResources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "semanticContractFingerprint": {
      "type": "string",
      "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"
    }
  }
}
