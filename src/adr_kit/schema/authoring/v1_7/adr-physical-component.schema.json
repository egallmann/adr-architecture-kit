{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/authoring/v1.7/adr-physical-component.schema.json",
  "title": "Physical-Component ADR Schema (authoring v1.7)",
  "allOf": [{"$ref": "adr-physical-base.schema.json"}],
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.7"}, "adr_type": {"const": "physical-component"}, "id": {"$ref": "types.schema.json#/definitions/uuid_v7"}, "alias_id": {"type": "string", "pattern": "^ADR-PC-[0-9]{4}$"}, "alias_name": {"$ref": "types.schema.json#/definitions/alias_name"},
    "title": {"type": "string", "minLength": 5, "maxLength": 200}, "status": {"$ref": "types.schema.json#/definitions/status"}, "created_date": {"$ref": "types.schema.json#/definitions/iso_date"}, "modified_date": {"$ref": "types.schema.json#/definitions/iso_date"}, "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "domains": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "array", "items": {"type": "string"}}, "related_adrs": {"type": "array", "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "supersedes": {"type": "array", "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "superseded_by": {"$ref": "types.schema.json#/definitions/uuid_v7"}, "projection_signals": {"type": "array", "items": {"type": "string"}},
    "ownership": {"type": "object", "additionalProperties": false, "properties": {"architecture_authority": {"type": "string"}, "implementation_owners": {"type": "array", "items": {"type": "string"}}}}, "governance": {"type": "object", "additionalProperties": false, "properties": {"implementation_authority": {"enum": ["none", "advisory", "implementation_authoritative"]}, "approved_by": {"type": "string"}, "approved_date": {"type": "string"}}},
    "implements_logical": {"type": "array", "minItems": 1, "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "implements_system": {"type": "array", "minItems": 1, "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "context": {"type": "string"}, "technologies": {"type": "array", "items": {"type": "string"}}, "technology_stack": {"type": "array", "minItems": 1, "items": {"$ref": "types.schema.json#/definitions/technology_choice"}},
    "component_specifications": {"type": "array", "minItems": 1, "items": {"$ref": "adr-common.schema.json#/definitions/component"}},
    "implementation_decisions": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/implementation_decision"}},
    "data_architecture": {"type": "array", "items": {"type": "object", "required": ["entity", "storage"], "properties": {"entity": {"type": "string"}, "storage": {"type": "string"}, "schema": {"type": "string"}, "access_patterns": {"type": "string"}, "indexes": {"type": "array", "items": {"type": "string"}}, "migrations": {"type": "string"}}, "additionalProperties": false}},
    "integration_points": {"type": "array", "items": {"type": "object", "required": ["id", "systems", "protocol", "specification"], "properties": {"id": {"type": "string"}, "systems": {"type": "array", "minItems": 2, "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "protocol": {"type": "string"}, "specification": {"type": "string"}, "contract_adr": {"$ref": "types.schema.json#/definitions/uuid_v7"}}, "additionalProperties": false}},
    "deployment_model": {"type": "object", "additionalProperties": false, "properties": {"hosting": {"enum": ["cloud", "on-premise", "hybrid", "edge"]}, "orchestration": {"type": "string"}, "scaling_strategy": {"type": "string"}}}, "operational_requirements": {"type": "object", "additionalProperties": false, "properties": {"monitoring": {"type": "string"}, "logging": {"type": "string"}, "backup_recovery": {"type": "string"}, "security": {"type": "string"}}},
    "gaps": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/gap"}}, "normative_propositions": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/normative_proposition"}}, "evidence_expectations": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/evidence_expectation"}}, "extension_entities": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/custom_entity"}}, "extension_relationships": {"type": "array", "items": {"$ref": "adr-common.schema.json#/definitions/custom_relationship"}}
  },
  "required": ["schema_version", "adr_type", "id", "alias_id", "alias_name", "title", "status", "created_date", "authors", "implements_logical", "implements_system", "context", "technology_stack", "component_specifications"],
  "additionalProperties": false
}
