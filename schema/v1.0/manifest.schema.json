{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.0/manifest.schema.json",
  "title": "ADR Manifest Schema",
  "description": "Schema for generated manifest.yaml (derived from ADRs, never manually edited, SYS-14: Index Currency)",
  
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "generated_date",
    "generated_from",
    "adrs",
    "statistics"
  ],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    
    "type": {
      "const": "manifest"
    },
    
    "generated_date": {
      "$ref": "types.schema.json#/definitions/iso_datetime",
      "description": "When this manifest was generated"
    },
    
    "generated_from": {
      "type": "string",
      "description": "Glob pattern of source ADRs (e.g., adrs/**/*.yaml)"
    },
    
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "status", "file_path"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/adr_id_any"
          },
          "type": {
            "type": "string",
            "enum": ["logical", "physical", "physical-system", "physical-component", "decision"]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "types.schema.json#/definitions/status"
          },
          "file_path": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {"type": "string"}
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "implements_logical": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/adr_id_logical"
            }
          },
          "technologies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "decision_count": {
            "type": "integer",
            "minimum": 0
          },
          "invariant_count": {
            "type": "integer",
            "minimum": 0
          },
          "gap_count": {
            "type": "integer",
            "minimum": 0
          },
          "blocking_gaps": {
            "type": "integer",
            "minimum": 0
          },
          "component_count": {
            "type": "integer",
            "minimum": 0
          },
          "implementation_authority": {
            "$ref": "types.schema.json#/definitions/implementation_authority"
          },
          "related_reviews": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/review_id"
            }
          },
          "related_overrides": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/override_id"
            }
          },
          "related_ledgers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^LEDGER-\\d{4}$"
            }
          }
        }
      },
      "description": "List of all ADRs with aggregated metadata"
    },
    
    "by_domain": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/definitions/adr_id_any"
        }
      },
      "description": "ADRs indexed by domain"
    },
    
    "by_status": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/definitions/adr_id_any"
        }
      },
      "description": "ADRs indexed by status"
    },
    
    "by_technology": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/definitions/adr_id_physical"
        }
      },
      "description": "Physical ADRs indexed by technology"
    },
    
    "logical_to_physical_map": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/definitions/adr_id_physical"
        }
      },
      "description": "Mapping of logical ADRs to implementing physical ADRs"
    },
    
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "defined_in", "enforcement_level"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/invariant_id"
          },
          "statement": {
            "type": "string"
          },
          "defined_in": {
            "$ref": "types.schema.json#/definitions/adr_id_any"
          },
          "enforced_by": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/adr_id_physical"
            }
          },
          "enforcement_level": {
            "$ref": "types.schema.json#/definitions/enforcement_level"
          }
        }
      },
      "description": "All invariants extracted from ADRs"
    },
    
    "gaps_summary": {
      "type": "object",
      "required": ["total", "blocking"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        },
        "by_adr": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "total": {"type": "integer"},
              "blocking": {"type": "integer"}
            }
          }
        }
      },
      "description": "Summary of gaps across all ADRs"
    },
    
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "name", "introduced_by", "lifecycle_stage"],
        "properties": {
          "entity_id": {
            "$ref": "types.schema.json#/definitions/entity_id"
          },
          "entity_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "introduced_by": {
            "$ref": "types.schema.json#/definitions/adr_id_any"
          },
          "lifecycle_stage": {
            "type": "string"
          }
        }
      },
      "description": "All entities across all ADRs"
    },

    "requirements_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["snapshot_id", "domains"],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "pattern": "^REQ-\\d{4}$"
          },
          "domains": {
            "type": "array",
            "items": {"type": "string"}
          },
          "capability_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Requirements snapshots summary"
    },

    "decision_ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ledger_id", "target_logical_adr"],
        "properties": {
          "ledger_id": {
            "type": "string",
            "pattern": "^LEDGER-\\d{4}$"
          },
          "target_logical_adr": {
            "$ref": "types.schema.json#/definitions/adr_id_logical"
          },
          "decision_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Decision ledgers summary"
    },

    "objection_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "related_adr", "implementation_effect"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/override_id"
          },
          "related_adr": {
            "$ref": "types.schema.json#/definitions/adr_id_any"
          },
          "related_review": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "types.schema.json#/definitions/review_id"}
            ]
          },
          "implementation_effect": {
            "type": "string",
            "enum": ["exception", "deferred_compliance", "risk_accepted_variance"]
          }
        }
      },
      "description": "Objection overrides summary"
    },
    "steelman_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target_adr", "review_kind", "overall_recommendation"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/review_id"
          },
          "target_adr": {
            "$ref": "types.schema.json#/definitions/adr_id_any"
          },
          "review_kind": {
            "type": "string",
            "enum": ["steelman"]
          },
          "overall_recommendation": {
            "type": "string"
          },
          "objection_count": {
            "type": "integer",
            "minimum": 0
          },
          "blocking_objections": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "Steelman review summary"
    },

    "statistics": {
      "type": "object",
      "required": ["total_adrs", "logical_adrs", "physical_adrs"],
      "properties": {
        "total_adrs": {
          "type": "integer",
          "minimum": 0
        },
        "logical_adrs": {
          "type": "integer",
          "minimum": 0
        },
        "physical_adrs": {
          "type": "integer",
          "minimum": 0
        },
        "decision_adrs": {
          "type": "integer",
          "minimum": 0
        },
        "total_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "total_invariants": {
          "type": "integer",
          "minimum": 0
        },
        "total_components": {
          "type": "integer",
          "minimum": 0
        },
        "total_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "total_entities": {
          "type": "integer",
          "minimum": 0
        },
        "total_requirements_snapshots": {
          "type": "integer",
          "minimum": 0
        },
        "total_decision_ledgers": {
          "type": "integer",
          "minimum": 0
        },
        "total_objection_overrides": {
          "type": "integer",
          "minimum": 0
        },
        "total_steelman_reviews": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Aggregate statistics"
    }
  }
}
