{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.0/adr-physical-system.schema.json",
  "title": "Physical-System ADR Schema",
  "description": "Schema for Physical-System ADRs - high-level system architecture with component topology and integration patterns (STE-compliant, AI-first)",
  
  "type": "object",
  "allOf": [
    {"$ref": "adr-physical-base.schema.json"}
  ],
  
  "required": [
    "system_boundaries"
  ],
  
  "properties": {
    "adr_type": {
      "const": "physical-system"
    },
    
    "id": {
      "$ref": "types.schema.json#/definitions/adr_id_physical_system"
    },
    
    "system_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^SYSBOUND-\\d{4}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "external_dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "External systems this boundary depends on"
          },
          "exposed_interfaces": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Interfaces exposed by this boundary"
          }
        }
      },
      "minItems": 1,
      "description": "System boundaries and what they encapsulate"
    },
    
    "component_topology": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "purpose"],
            "properties": {
              "name": {"type": "string"},
              "type": {
                "type": "string",
                "enum": ["service", "database", "queue", "cache", "gateway", "proxy", "worker", "scheduler"]
              },
              "purpose": {"type": "string"},
              "implements_adr": {
                "$ref": "types.schema.json#/definitions/adr_id_physical_component",
                "description": "Physical-Component ADR that implements this component"
              }
            }
          },
          "description": "High-level component list"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "type"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "type": {
                "type": "string",
                "enum": ["calls", "publishes_to", "subscribes_to", "reads_from", "writes_to", "depends_on"]
              },
              "protocol": {"type": "string"},
              "description": {"type": "string"}
            }
          },
          "description": "Relationships between components"
        }
      },
      "description": "High-level component topology and relationships"
    },
    
    "integration_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_name", "application"],
        "properties": {
          "pattern_name": {
            "type": "string"
          },
          "application": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "components_affected": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rationale": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          }
        }
      },
      "description": "Integration patterns applied in this system"
    },
    
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^FLOW-\\d{4}$"
          },
          "name": {"type": "string"},
          "description": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "path": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Component names in flow order"
          },
          "data_type": {"type": "string"},
          "volume": {"type": "string"},
          "latency_requirements": {"type": "string"}
        }
      },
      "description": "High-level data flows through the system"
    },
    
    "references_components": {
      "type": "array",
      "items": {
        "$ref": "types.schema.json#/definitions/adr_id_physical_component"
      },
      "description": "Physical-Component ADRs that implement parts of this system (optional, for traceability)"
    },
    
    "scalability_strategy": {
      "type": "object",
      "properties": {
        "horizontal_scaling": {
          "$ref": "types.schema.json#/definitions/markdown_text"
        },
        "vertical_scaling": {
          "$ref": "types.schema.json#/definitions/markdown_text"
        },
        "bottlenecks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "capacity_planning": {
          "$ref": "types.schema.json#/definitions/markdown_text"
        }
      },
      "description": "System-level scalability strategy"
    },
    
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "impact", "mitigation"],
        "properties": {
          "scenario": {"type": "string"},
          "impact": {
            "$ref": "types.schema.json#/definitions/impact_level"
          },
          "mitigation": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "detection": {"type": "string"},
          "recovery": {"type": "string"}
        }
      },
      "description": "System-level failure modes and mitigations"
    }
  }
}
