{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/authoring/v1.7/adr-physical-base.schema.json",
  "title": "Physical ADR Base Schema (authoring v1.7)",
  "type": "object",
  "properties": {
    "implements_logical": {"type": "array", "minItems": 1, "items": {"$ref": "types.schema.json#/definitions/uuid_v7"}},
    "context": {"type": "string"},
    "technologies": {"type": "array", "items": {"type": "string"}},
    "technology_stack": {"type": "array", "minItems": 1, "items": {"$ref": "types.schema.json#/definitions/technology_choice"}}
  },
  "required": ["implements_logical", "context", "technology_stack"]
}
