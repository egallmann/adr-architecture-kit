{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.0/adr-logical.schema.json",
  "title": "Logical ADR Schema",
  "description": "Schema for Logical ADRs - conceptual design decisions without implementation details (STE-compliant, PRIME-1, PRIME-2, SYS-5)",
  
  "type": "object",
  "allOf": [
    {"$ref": "adr-common.schema.json"},
    {
      "properties": {
        "adr_type": {
          "const": "logical"
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/adr_id_logical"
          }
        }
      },
      "then": {
        "required": [
          "context",
          "decisions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/adr_id_vision"
          }
        }
      },
      "then": {
        "required": [
          "context",
          "vision_category"
        ],
        "properties": {
          "vision_category": {
            "const": true
          }
        }
      }
    }
  ],
  
  "properties": {
    "context": {
      "$ref": "types.schema.json#/definitions/markdown_text",
      "description": "Problem space, business drivers, constraints (markdown)"
    },
    
    "vision_category": {
      "type": "boolean",
      "description": "True when this ADR is a vision-oriented logical ADR."
    },
    
    "promotable_to_logical": {
      "type": "boolean",
      "description": "Whether this vision ADR is intended to be promotable into a fully realized ADR-L."
    },
    
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^CAP-\\d{4}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "implemented_by_components": {
            "type": "array",
            "items": {"type": "string"}
          },
          "enabled_by_decisions": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/entity_id"
            }
          }
        }
      },
      "description": "System capabilities defined by this ADR"
    },
    
    "architectural_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "rationale"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^BOUND-\\d{4}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "rationale": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          }
        }
      },
      "description": "Architectural boundaries and separation of concerns"
    },
    
    "interaction_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "parties", "protocol", "guarantees"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^CONTRACT-\\d{4}$"
          },
          "parties": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 2
          },
          "protocol": {
            "type": "string"
          },
          "guarantees": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          }
        }
      },
      "description": "Interaction contracts between components"
    },
    
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "rationale"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^CONST-\\d{4}$"
          },
          "type": {
            "type": "string",
            "enum": ["technical", "business", "regulatory", "performance", "security"]
          },
          "description": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "rationale": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          }
        }
      },
      "description": "Constraints that shape the architecture"
    },
    
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "scope", "enforcement_level", "enforcement_mechanism", "verification_method", "rationale"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/invariant_id"
          },
          "statement": {
            "type": "string",
            "description": "What must always be true"
          },
          "scope": {
            "type": "string",
            "description": "Scope of invariant (global, domain name, or component name)"
          },
          "enforcement_level": {
            "$ref": "types.schema.json#/definitions/enforcement_level"
          },
          "enforcement_mechanism": {
            "type": "string",
            "enum": ["design", "runtime", "test", "policy"]
          },
          "verification_method": {
            "type": "string",
            "enum": ["automated", "manual", "audit"]
          },
          "rationale": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "declaration_mode": {
            "type": "string",
            "enum": ["canonical", "local", "reference"]
          },
          "upheld_by_decisions": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/entity_id"
            }
          },
          "policy_reference": {
            "type": "string",
            "description": "Reference to organizational policy (enables policy validation)"
          },
          "compliance_frameworks": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Compliance frameworks this invariant supports (e.g., SOC2, GDPR)"
          },
          "exceptions": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Granted exceptions to this invariant"
          }
        }
      },
      "description": "Invariants that must hold (enables policy validation and enforcement)"
    },
    
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "requirement", "acceptance_criteria"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^NFR-\\d{4}$"
          },
          "category": {
            "type": "string",
            "enum": ["performance", "security", "scalability", "reliability", "maintainability", "usability"]
          },
          "requirement": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "acceptance_criteria": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          }
        }
      },
      "description": "Non-functional requirements"
    },
    
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "rationale"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^DEC-\\d{4}$"
          },
          "summary": {
            "type": "string",
            "description": "Brief decision statement"
          },
          "rationale": {
            "$ref": "types.schema.json#/definitions/markdown_text",
            "description": "Why this decision was made"
          },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "rejected_because"],
              "properties": {
                "name": {"type": "string"},
                "rejected_because": {
                  "$ref": "types.schema.json#/definitions/markdown_text"
                }
              }
            }
          },
          "consequences": {
            "type": "object",
            "properties": {
              "positive": {
                "type": "array",
                "items": {"type": "string"}
              },
              "negative": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "related_invariants": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/invariant_id"
            },
            "description": "Invariants this decision enforces or relates to"
          },
          "enforces_invariants": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/invariant_id"
            }
          },
          "enables_capabilities": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/entity_id"
            }
          },
          "governs_components": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supersedes": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/entity_id"
            }
          },
          "refines": {
            "type": "array",
            "items": {
              "$ref": "types.schema.json#/definitions/entity_id"
            }
          }
        }
      },
      "minItems": 1,
      "description": "Architectural decisions made in this ADR"
    },
    
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "impact", "blocking"],
        "properties": {
          "id": {
            "$ref": "types.schema.json#/definitions/entity_id",
            "pattern": "^GAP-\\d{4}$"
          },
          "question": {
            "type": "string",
            "description": "Unresolved design question"
          },
          "context": {
            "$ref": "types.schema.json#/definitions/markdown_text"
          },
          "impact": {
            "$ref": "types.schema.json#/definitions/impact_level"
          },
          "blocking": {
            "type": "boolean",
            "description": "Does this gap block implementation?"
          },
          "affects": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Components or decisions affected by this gap"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {"type": "string"},
                "pros": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "cons": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "decision_required_from": {
            "type": "string",
            "description": "Who needs to resolve this gap"
          }
        }
      },
      "description": "Explicit gaps and unresolved questions (SYS-4: makes incompleteness explicit)"
    }
  }
}
