{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/requirements-snapshot.schema.json",
  "title": "Requirements Snapshot Schema",
  "description": "Captures requirements interrogation state at a point in time",
  
  "type": "object",
  "required": ["schema_version", "type", "snapshot_id", "created_date"],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "type": {
      "const": "requirements_snapshot"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^REQ-\\d{4}$"
    },
    "created_date": {
      "$ref": "../v1.0/types.schema.json#/definitions/iso_date"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_item_id", "name", "description"],
        "properties": {
          "req_item_id": {
            "type": "string",
            "pattern": "^RQCAP-\\d{4}$",
            "description": "Snapshot-local capability identifier"
          },
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "description": "Required capabilities (pre-ADR, snapshot-local IDs)"
    },
    "required_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_item_id", "statement"],
        "properties": {
          "req_item_id": {
            "type": "string",
            "pattern": "^RQCONST-\\d{4}$",
            "description": "Snapshot-local constraint identifier"
          },
          "statement": {"type": "string"}
        }
      },
      "description": "Required constraints (pre-ADR, snapshot-local IDs)"
    },
    "required_invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_item_id", "statement"],
        "properties": {
          "req_item_id": {
            "type": "string",
            "pattern": "^RQINV-\\d{4}$",
            "description": "Snapshot-local invariant identifier"
          },
          "statement": {"type": "string"}
        }
      },
      "description": "Required invariants (pre-ADR, snapshot-local IDs)"
    },
    "required_nfrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_item_id", "statement", "acceptance_criteria"],
        "properties": {
          "req_item_id": {
            "type": "string",
            "pattern": "^RQNFR-\\d{4}$",
            "description": "Snapshot-local NFR identifier"
          },
          "statement": {"type": "string"},
          "acceptance_criteria": {"type": "string"}
        }
      },
      "description": "Required NFRs (pre-ADR, snapshot-local IDs)"
    },
    "domains": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Business/technical domains in scope"
    },
    "technology_signals": {
      "type": "object",
      "properties": {
        "language": {"type": "string"},
        "infrastructure": {"type": "string"},
        "architecture_pattern": {"type": "string"}
      },
      "description": "Technology stack signals for rule activation"
    },
    "feeds_logical_adr": {
      "$ref": "../v1.0/types.schema.json#/definitions/adr_id_logical",
      "description": "Logical ADR this snapshot feeds"
    }
  }
}
