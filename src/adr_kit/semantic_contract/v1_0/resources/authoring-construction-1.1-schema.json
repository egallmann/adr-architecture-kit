            "input_basis_digest": {
              "$ref": "#/$defs/digest"
            },
            "architecture_interpretation_fingerprint": {
              "const": "scf:v1:sha256:2a9300b1d7bdc9a80421cb94294fbd2f345531b5147644d02ae4bcc5c436d75a"
            }
          },
          "additionalProperties": false
        },
        "normalized_model": {
          "type": "object",
          "required": [
            "schema_validation",
