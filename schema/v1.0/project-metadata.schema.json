{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.0/project-metadata.schema.json",
  "title": "PROJECT.yaml Schema",
  "description": "Schema for project-level metadata (one per repository, enables automation and correction agent context)",
  
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "project",
    "ownership",
    "repository",
    "architecture_documentation"
  ],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    
    "type": {
      "const": "project_metadata"
    },
    
    "project": {
      "type": "object",
      "required": ["name", "description", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Project name (lowercase, hyphenated)"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["service", "library", "platform", "system", "tool"]
        }
      }
    },
    
    "ownership": {
      "type": "object",
      "required": ["team"],
      "properties": {
        "team": {
          "type": "string"
        },
        "tech_lead": {
          "type": "string"
        },
        "on_call": {
          "type": "object",
          "properties": {
            "schedule": {"type": "string"},
            "rotation": {
              "type": "string",
              "enum": ["daily", "weekly", "biweekly", "monthly"]
            },
            "members": {
              "type": "array",
              "items": {"type": "string"}
            },
            "backup": {"type": "string"}
          }
        }
      }
    },
    
    "repository": {
      "type": "object",
      "required": ["url", "primary_branch"],
      "properties": {
        "url": {
          "type": "string"
        },
        "primary_branch": {
          "type": "string"
        }
      }
    },
    
    "implementation_identifiers": {
      "type": "object",
      "properties": {
        "service_name": {
          "type": "string",
          "description": "Runtime service name (Kubernetes, Docker, etc.)"
        },
        "namespace": {
          "type": "string",
          "description": "Kubernetes namespace or equivalent"
        },
        "deployment_name": {
          "type": "string"
        },
        "package_name": {
          "type": "string",
          "description": "Package name for libraries"
        },
        "module_path": {
          "type": "string",
          "description": "Primary module path"
        }
      },
      "description": "Identifiers for correction agents to locate and operate on this project"
    },
    
    "automation": {
      "type": "object",
      "properties": {
        "auto_merge_allowed": {
          "type": "boolean",
          "default": false
        },
        "auto_deploy_staging": {
          "type": "boolean",
          "default": false
        },
        "auto_deploy_production": {
          "type": "boolean",
          "default": false
        },
        "requires_human_review": {
          "type": "boolean",
          "default": true
        },
        "comfort_level": {
          "type": "string",
          "enum": ["conservative", "moderate", "aggressive"],
          "default": "conservative"
        }
      },
      "description": "Automation permissions for correction agents"
    },
    
    "development_methodology": {
      "type": "object",
      "properties": {
        "approach": {
          "type": "string",
          "enum": ["test-driven-development", "behavior-driven-development", "test-after", "exploratory"],
          "description": "Primary development methodology"
        },
        "testing_framework": {
          "type": "string",
          "description": "Testing framework used (e.g., pytest, jest, vitest)"
        },
        "coverage_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Target code coverage percentage"
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "schema_validation",
              "test_suite_passing", 
              "type_checking",
              "linting",
              "security_scanning",
              "deprecation_free_runtime",
              "dependency_security_audit",
              "dependency_freshness_review",
              "coverage_threshold",
              "performance_benchmarks"
            ]
          },
          "description": "Required quality gates for CI/CD"
        },
        "tdd_cycle": {
          "type": "string",
          "enum": ["red-green-refactor", "test-first", "test-after"],
          "description": "TDD cycle approach if using TDD"
        },
        "rationale": {
          "type": "string",
          "description": "Rationale for methodology choice"
        },
        "authority": {
          "type": "string",
          "description": "ADR that defines this methodology (e.g., ADR-L-0003 DEC-0005)"
        }
      },
      "description": "Development methodology and quality practices (project authority declaration)"
    },
    
    "integrations": {
      "type": "object",
      "properties": {
        "scm": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["github", "gitlab", "bitbucket"]
            },
            "app_installation_id": {"type": "string"},
            "required_approvers": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "ci": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["github_actions", "jenkins", "circleci", "gitlab_ci"]
            },
            "workflow_path": {"type": "string"},
            "required_checks": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "observability": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["datadog", "prometheus", "cloudwatch", "newrelic"]
                },
                "dashboards": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            },
            "logs": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["cloudwatch", "datadog", "splunk", "elasticsearch"]
                },
                "log_groups": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            },
            "alerts": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["pagerduty", "opsgenie", "victorops"]
                },
                "escalation_policy": {"type": "string"}
              }
            }
          }
        }
      },
      "description": "Integration configurations for automation"
    },
    
    "compliance": {
      "type": "object",
      "properties": {
        "security_level": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "data_classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "regulatory_requirements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "license": {
          "type": "string"
        },
        "required_controls": {
          "type": "object",
          "properties": {
            "encryption_at_rest": {"type": "boolean"},
            "encryption_in_transit": {"type": "boolean"},
            "mfa_required": {"type": "boolean"},
            "audit_logging": {"type": "boolean"}
          }
        }
      },
      "description": "Compliance and security requirements"
    },
    
    "architecture_documentation": {
      "type": "object",
      "required": ["adr_directory"],
      "properties": {
        "adr_directory": {
          "type": "string",
          "default": "adrs/"
        },
        "manifest_path": {
          "type": "string",
          "default": "adrs/manifest.yaml"
        }
      },
      "description": "Location of architecture documentation"
    }
  }
}
