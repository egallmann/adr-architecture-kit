            "status": {
              "enum": [
                "semantic_equivalent",
                "semantic_mismatch",
                "not_evaluated"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "all_expected_accounted": {
              "type": "boolean"
            },
            "all_observed_accounted": {
              "type": "boolean"
            },
            "mismatches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/semantic_mismatch_diagnostic"
              }
            }
          },
          "additionalProperties": false
        }
