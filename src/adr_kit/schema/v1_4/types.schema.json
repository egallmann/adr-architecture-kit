{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/authoring/v1.4/types.schema.json",
  "title": "ADR Kit Shared Type Definitions (authoring v1.4)",
  "definitions": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "alias_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "extension_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"
    },
    "extension_alias": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{4}$"
    },
    "extension_property_scalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "extension_property_value": {
      "oneOf": [
        {"$ref": "#/definitions/extension_property_scalar"},
        {"type": "array", "items": {"$ref": "#/definitions/extension_property_scalar"}}
      ]
    },
    "extension_properties": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/definitions/extension_property_value"}
    },
    "status": {"type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"]},
    "iso_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
