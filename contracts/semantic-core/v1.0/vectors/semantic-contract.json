    {
      "name": "jcs_orders_keys_without_normalizing_values",
      "request": {
        "core_contract_version": "1.0",
        "operation": "canonicalize_semantic_json",
        "value": {"z": 1, "a": [true, null, "é"]}
      },
      "expected": {
        "success": true,
        "canonical_preimage_json": "{\"a\":[true,null,\"é\"],\"z\":1}",
        "fingerprint": "sha256:9622d8e9f6fcc94dd1013e9af622df506351bf2009314dda0ab155ff2bb338ab"
      }
    },
    {
      "name": "duplicate_json_members_are_rejected_at_the_boundary",
      "request": {
        "core_contract_version": "1.0",
        "operation": "canonicalize_semantic_json",
        "value_json": "{\"x\":1,\"x\":2}"
      },
      "expected": {
        "success": false,
        "diagnostic_codes": ["semantic_contract.invalid_json"]
      }
    },
    {
