{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/remediation-ledger.schema.json",
  "title": "Remediation Ledger Schema",
  "description": "Governance ledger for monotonic sentinel remediation",
  "type": "object",
  "required": ["schema_version", "type", "entries"],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "type": {
      "const": "remediation_ledger"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_ref", "state"],
        "properties": {
          "field_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical field reference, e.g. entity:CAP-1000.summary"
          },
          "state": {
            "type": "string",
            "enum": ["sentinel", "pending_approval", "approved"]
          },
          "authority_ref": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "$ref": "../v1.0/types.schema.json#/definitions/iso_datetime"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
