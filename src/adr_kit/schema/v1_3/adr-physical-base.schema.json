{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.3/adr-physical-base.schema.json",
  "title": "Physical ADR Base Schema (v1.3)",
  "description": "Shared base schema for Physical-System and Physical-Component ADRs — v1.3 identity",

  "type": "object",
  "allOf": [
    {"$ref": "adr-common.schema.json"}
  ],

  "required": [
    "implements_logical",
    "context",
    "technology_stack"
  ],

  "properties": {
    "implements_logical": {
      "type": "array",
      "items": { "$ref": "types.schema.json#/definitions/uuid_v7" },
      "minItems": 1,
      "description": "Logical ADRs this physical ADR implements (by UUID)"
    },

    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },

    "context": {
      "$ref": "types.schema.json#/definitions/markdown_text"
    },

    "technology_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "name", "version", "rationale"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["language", "framework", "library", "database", "messaging", "infrastructure", "tooling"]
          },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "rationale": { "$ref": "types.schema.json#/definitions/markdown_text" },
          "inferred": { "type": "boolean" }
        }
      },
      "minItems": 1
    },

    "deployment_model": {
      "type": "object",
      "properties": {
        "hosting": {
          "type": "string",
          "enum": ["cloud", "on-premise", "hybrid", "edge"]
        },
        "orchestration": { "type": "string" },
        "scaling_strategy": { "$ref": "types.schema.json#/definitions/markdown_text" }
      }
    },

    "operational_requirements": {
      "type": "object",
      "properties": {
        "monitoring": { "$ref": "types.schema.json#/definitions/markdown_text" },
        "logging": { "$ref": "types.schema.json#/definitions/markdown_text" },
        "backup_recovery": { "$ref": "types.schema.json#/definitions/markdown_text" },
        "security": { "$ref": "types.schema.json#/definitions/markdown_text" }
      }
    },

    "conversation_metadata": {
      "type": "object",
      "properties": {
        "creation_method": {
          "type": "string",
          "enum": ["ai_interview", "human_written", "migrated", "watchdog_inferred"]
        },
        "interview_transcript_ref": { "type": "string" },
        "gaps_resolved": {
          "type": "array",
          "items": { "type": "string", "pattern": "^GAP-\\d{4}$" }
        },
        "human_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "decision"],
            "properties": {
              "question": { "type": "string" },
              "decision": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "context_signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "activated_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "implementation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{"$ref": "adr-common.schema.json#/definitions/identity_envelope"}],
        "required": ["id", "alias_id", "alias_name", "summary", "rationale"],
        "properties": {
          "id": { "$ref": "types.schema.json#/definitions/uuid_v7" },
          "alias_id": { "$ref": "types.schema.json#/definitions/entity_id", "pattern": "^IMPL-\\d{4}$" },
          "alias_name": { "$ref": "types.schema.json#/definitions/alias_name" },
          "summary": { "type": "string" },
          "rationale": { "$ref": "types.schema.json#/definitions/markdown_text" },
          "implements_invariants": {
            "type": "array",
            "items": { "$ref": "types.schema.json#/definitions/uuid_v7" }
          },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "rejected_because"],
              "properties": {
                "name": { "type": "string" },
                "rejected_because": { "$ref": "types.schema.json#/definitions/markdown_text" }
              }
            }
          }
        }
      }
    },

    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "impact", "blocking"],
        "properties": {
          "id": { "$ref": "types.schema.json#/definitions/entity_id", "pattern": "^GAP-\\d{4}$" },
          "question": { "type": "string" },
          "context": { "$ref": "types.schema.json#/definitions/markdown_text" },
          "impact": { "$ref": "types.schema.json#/definitions/impact_level" },
          "blocking": { "type": "boolean" },
          "affects": { "type": "array", "items": { "type": "string" } },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "pros": { "type": "array", "items": { "type": "string" } },
                "cons": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "decision_required_from": { "type": "string" }
        }
      }
    }
  }
}
