{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.ste.systems/contracts/architecture-interpretation/v1.1/schema.json",
  "title": "ADR-Kit Architecture Interpretation Contract 1.1 shape",
  "type": "object",
  "required": ["contract_id", "contract_version", "contract_family", "fingerprint_scheme", "contract_fingerprint", "status", "source_contract", "output_contract", "relationship_modes", "forward_type_dispositions", "source_decoding", "absence_semantics", "legacy_compatibility", "resources", "public_boundary"],
  "properties": {
    "$schema": {"const": "./schema.json"}, "contract_id": {"const": "adr-kit.architecture-interpretation"}, "contract_version": {"const": "1.1"}, "contract_family": {"const": "architecture_interpretation"}, "fingerprint_scheme": {"const": "scf:v1:sha256"}, "contract_fingerprint": {"type": "string", "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"}, "status": {"const": "descriptive_read_only"},
    "source_contract": {"type": "object", "required": ["family", "version", "qualification", "exact_source_basis"], "properties": {"family": {"const": "authoring"}, "version": {"const": "1.7"}, "qualification": {"const": "exact-schema-artifacts-and-source-bytes"}, "exact_source_basis": {"const": true}}, "additionalProperties": false},
    "output_contract": {"type": "object", "required": ["family", "version", "qualification"], "properties": {"family": {"const": "normalized-model"}, "version": {"const": "2.4"}, "qualification": {"const": "exact-schema-artifacts"}}, "additionalProperties": false},
    "relationship_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["explicit", "composition_derived", "field_derived", "compatibility_projection", "custom_explicit"]}},
    "forward_type_dispositions": {"type": "array", "minItems": 27, "items": {"$ref": "#/$defs/disposition"}},
    "source_decoding": {"type": "object"}, "absence_semantics": {"type": "object"}, "legacy_compatibility": {"type": "object"},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "public_boundary": {"type": "object", "required": ["advertised", "execution", "selected_by_current_semantic_contract_set"], "properties": {"advertised": {"const": false}, "execution": {"const": "not_implemented"}, "selected_by_current_semantic_contract_set": {"const": false}}, "additionalProperties": false}
  },
  "$defs": {
    "disposition": {"type": "object", "required": ["source", "kind", "normalized", "relationship_mode", "identity"], "properties": {"source": {"type": "string"}, "kind": {"enum": ["adr", "entity", "relationship", "value"]}, "normalized": {"type": "string"}, "relationship_mode": {"enum": ["explicit", "composition_derived", "field_derived", "compatibility_projection", "custom_explicit"]}, "identity": {"enum": ["canonical_uuidv7", "owner_local", "owner_local_relationship_value", "none", "custom_contract_qualified"]}, "presence": {"type": "string"}, "notes": {"type": "string"}}, "additionalProperties": false},
    "resource": {"type": "object", "required": ["key", "path", "content_digest", "role"], "properties": {"key": {"type": "string"}, "path": {"type": "string"}, "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "role": {"enum": ["rule", "source-decoding", "source-mapping", "legacy-composition", "conformance"]}, "dependencies": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  }
}
