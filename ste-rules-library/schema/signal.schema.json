{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ste-rules-library.ste.systems/schema/signal.schema.json",
  "title": "Cooperative Signal Schema",
  "description": "Canonical schema for agent coordination signals. Authority: adr-architecture-kit ADR-L-0006, ste-rules-library ADR-L-0001",

  "type": "object",
  "required": ["signal_type", "timestamp"],
  "properties": {
    "signal_type": {
      "type": "string",
      "enum": ["claim", "progress", "complete", "wave_complete", "validation_ready"],
      "description": "Cooperative signal type for agent coordination"
    },
    "component_id": {
      "type": "string",
      "pattern": "^COMP-\\d{4}$",
      "description": "Component being implemented"
    },
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-[LP]-\\d{4}$",
      "description": "ADR being implemented"
    },
    "agent": {
      "type": "string",
      "enum": ["codex", "cursor", "claude", "gpt"],
      "description": "AI agent identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "metadata": {
      "type": "object",
      "description": "Signal-specific payload"
    }
  }
}
