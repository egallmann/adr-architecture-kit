{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/contracts/semantic-contract/v1.0/semantic-contract-set.schema.json",
  "title": "ADR-Kit immutable SemanticContractSet v1.0",
  "type": "object", "additionalProperties": false,
  "required": ["scsScheme", "semanticContractSetId", "members"],
  "properties": {
    "$schema": {"type": "string"}, "scsScheme": {"const": "scs:v1:sha256"},
    "semanticContractSetId": {"type": "string", "pattern": "^scs:v1:sha256:[0-9a-f]{64}$"},
    "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticContractFamily", "semanticContractVersion", "semanticContractFingerprint"],
      "properties": {
        "semanticContractFamily": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "semanticContractVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "semanticContractFingerprint": {"type": "string", "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"}
      }
    }}
  }
}
