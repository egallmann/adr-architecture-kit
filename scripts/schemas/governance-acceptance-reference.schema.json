{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adr-kit:governance-design:acceptance-reference:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "governing_adr_id",
    "reviewed_revision",
    "approval_review_url"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "canonical-governance-acceptance-reference"
    },
    "governing_adr_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reviewed_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approval_review_url": {
      "type": "string",
      "pattern": "^https://github.com/egallmann/adr-architecture-kit/pull/[0-9]+#pullrequestreview-[0-9]+$"
    }
  }
}
