          ],
          "properties": {
            "schema_validation": {
              "const": "valid"
            },
            "normalized_contract": {
              "$ref": "#/$defs/exact_nm24_closure"
            }
          },
          "additionalProperties": false
        },
        "expected_ledger": {
          "$ref": "ledger.schema.json"
        },
        "observed_ledger": {
          "$ref": "ledger.schema.json"
