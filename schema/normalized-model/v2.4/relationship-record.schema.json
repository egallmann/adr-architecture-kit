{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/normalized-model/v2.4/relationship-record.schema.json",
  "title": "Relationship Record v2.4",
  "description": "Canonical UUID relationships are distinct from noncanonical compatibility projections of owner-local topology.",
  "oneOf": [
    {
      "title": "Canonical relationship",
      "type": "object",
      "required": ["record_kind", "id", "alias_id", "alias_name", "relationship_type", "from_entity_id", "to_entity_id", "canonical_source_ref"],
      "properties": {
        "record_kind": {"const": "canonical"}, "id": {"$ref": "#/definitions/uuid_v7"}, "alias_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{4}$"}, "alias_name": {"$ref": "#/definitions/alias_name"}, "relationship_type": {"$ref": "#/definitions/relationship_type"}, "from_entity_id": {"$ref": "#/definitions/uuid_v7"}, "to_entity_id": {"$ref": "#/definitions/uuid_v7"}, "source_owner_id": {"type": ["string", "null"]}, "source_pointer": {"type": ["string", "null"]}, "provenance_classification": {"enum": ["explicit", "derived", "heuristic"]}, "evidence": {"type": "array"}, "canonical_source_ref": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "custom_qualification": {"$ref": "#/definitions/custom_relationship_qualification"}, "properties": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"relationship_type": {"pattern": ":"}}, "required": ["relationship_type"]}, "then": {"required": ["custom_qualification"]}}, {"if": {"properties": {"relationship_type": {"pattern": "^[^:]+$"}}, "required": ["relationship_type"]}, "then": {"not": {"required": ["custom_qualification"]}}}],
      "additionalProperties": false
    },
    {
      "title": "Compatibility projection",
      "type": "object",
      "required": ["record_kind", "relationship_id", "assertion_id", "relationship_type", "from_entity_id", "to_entity_id", "provenance_classification", "canonical_source_ref"],
      "properties": {
        "record_kind": {"const": "compatibility"}, "relationship_id": {"type": "string", "description": "Noncanonical compatibility identity; may be hash-derived."}, "assertion_id": {"type": "string", "pattern": "^asrt-[0-9a-f]{64}$"}, "relationship_type": {"enum": ["calls", "depends_on", "publishes_to", "reads_from", "subscribes_to", "writes_to", "composed_of", "consumes_interface"]}, "from_entity_id": {"$ref": "#/definitions/uuid_v7"}, "to_entity_id": {"$ref": "#/definitions/uuid_v7"}, "source_owner_id": {"type": ["string", "null"]}, "source_pointer": {"type": ["string", "null"]}, "provenance_classification": {"enum": ["explicit", "derived", "heuristic"]}, "evidence": {"type": "array"}, "canonical_source_ref": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "metadata": {"type": "object"}, "source_provenance": {"type": "object", "required": ["source_contract", "source_pointer"], "properties": {"source_contract": {"type": "string"}, "source_pointer": {"type": "string"}, "topology_key_endpoints": {"type": "object", "additionalProperties": false, "properties": {"from_key": {"type": "string"}, "to_key": {"type": "string"}}}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "alias_name": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "relationship_type": {"type": "string", "pattern": "^(?:calls|depends_on|publishes_to|reads_from|subscribes_to|writes_to|composed_of|consumes_interface|[A-Za-z0-9][A-Za-z0-9._-]*:[a-z][a-z0-9_]{1,63})$"},
    "custom_relationship_qualification": {"type": "object", "required": ["semantic_kind", "semantic_type", "consumer_namespace", "contract_version", "contract_fingerprint"], "properties": {"semantic_kind": {"const": "relationship"}, "semantic_type": {"type": "string"}, "consumer_namespace": {"type": "string"}, "contract_version": {"type": "string"}, "contract_fingerprint": {"type": "string", "pattern": "^cecf:v1:sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}
  }
}
