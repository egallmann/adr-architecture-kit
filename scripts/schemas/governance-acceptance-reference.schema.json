{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adr-kit:governance-design:acceptance-reference:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "governing_adr_id",
    "reviewed_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "canonical-governance-acceptance-reference"
    },
    "governing_adr_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reviewed_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approval_review_url": {
      "type": "string",
      "pattern": "^https://github.com/egallmann/adr-architecture-kit/pull/[0-9]+#pullrequestreview-[0-9]+$"
    },
    "owner_comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "author_login",
        "created_at",
        "source_url",
        "body_digest"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "author_login": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://github.com/egallmann/adr-architecture-kit/pull/187#issuecomment-[0-9]+$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "approval_review_url"
      ],
      "not": {
        "required": [
          "owner_comment"
        ]
      }
    },
    {
      "required": [
        "owner_comment"
      ],
      "not": {
        "required": [
          "approval_review_url"
        ]
      }
    }
  ]
}
