{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/contracts/semantic-core/v1.3/contract.json",
  "title": "ADR-Kit semantic core protocol contract v1.3",
  "description": "Closed successor transport boundary for authoring 1.7 materialization through the architecture-materialization 1.1 profile. The public execution path is intentionally unavailable in this slice.",
  "oneOf": [
    {"$ref": "#/$defs/materialization_request_envelope"},
    {"$ref": "#/$defs/materialization_result_envelope"},
    {"$ref": "#/$defs/invalid_result"}
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "source_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "authority_provider": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "architectureNamespace"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "architectureNamespace": {"type": "string", "minLength": 1}
      }
    },
    "source_contract_resource": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalResourceKey", "contentDigest"],
      "properties": {
        "canonicalResourceKey": {"type": "string", "pattern": "^authoring/1\\.7/schema/[a-z0-9-]+\\.schema$"},
        "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "source_contract_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "version", "schemaResource", "resourceClosure"],
      "properties": {
        "family": {"const": "authoring"},
        "version": {"const": "1.7"},
        "schemaResource": {"$ref": "#/$defs/source_contract_resource"},
        "resourceClosure": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_contract_resource"}
        }
      }
    },
    "source_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRef", "artifactPath", "contentDigest", "sourceContract", "document"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "artifactPath": {"type": "string", "minLength": 1},
        "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceContract": {"$ref": "#/$defs/source_contract_binding"},
        "document": {"type": "object"}
      }
    },
    "source_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["sealed", "providerSourceIdentity", "sourceRevision", "artifacts"],
      "properties": {
        "sealed": {"const": true},
        "providerSourceIdentity": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "string", "minLength": 1},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_artifact"}},
        "legacyIdentityMap": {"type": ["object", "null"]}
      }
    },
    "provider_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["packageVersion", "semanticCoreContractVersion", "hostBinding"],
      "properties": {
        "packageVersion": {"type": "string", "minLength": 1},
        "semanticCoreContractVersion": {"const": "1.3"},
        "hostBinding": {"type": "string", "minLength": 1}
      }
    },
    "successor_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profileFamily", "profileVersion", "profileId", "participatingFamilies", "operations", "selectionPurposes"],
      "properties": {
        "profileFamily": {"const": "architecture-materialization"},
        "profileVersion": {"const": "1.1"},
        "profileId": {"const": "architecture-materialization@1.1"},
        "participatingFamilies": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false, "required": ["semanticContractFamily", "semanticContractVersion", "cardinality"], "properties": {
            "semanticContractFamily": {"enum": ["architecture-interpretation", "normalized-model", "normative-semantics"]},
            "semanticContractVersion": {"enum": ["1.0", "1.1", "2.3", "2.4"]},
            "cardinality": {"const": 1}
          }}
        },
        "operations": {"type": "array", "contains": {"const": "materialize_architecture"}, "minItems": 1},
        "selectionPurposes": {"const": ["architecture-materialization"]}
      }
    },
    "corpus_inputs": {
      "type": "object",
      "required": ["profile", "definitions", "sets", "qualifications", "catalog", "policy"],
      "properties": {
        "profile": {"$ref": "#/$defs/successor_profile"},
        "definitions": {"type": "array", "items": {"type": "object"}},
        "sets": {"type": "array", "items": {"type": "object"}},
        "qualifications": {"type": "array", "items": {"type": "object"}},
        "catalog": {"type": "object"},
        "policy": {"type": "object"}
      }
    },
    "materialization_request_payload": {
      "allOf": [
        {"$ref": "#/$defs/corpus_inputs"},
        {
          "type": "object",
          "required": ["operation", "materializationContractVersion", "semanticContractSetId", "authorityProvider", "sourceBasis", "providerProvenance", "targetOperation", "direction", "useMode"],
          "properties": {
            "operation": {"const": "materialize_architecture"},
            "materializationContractVersion": {"const": "1.1"},
            "semanticContractSetId": {"type": "string", "pattern": "^scs:v1:sha256:[0-9a-f]{64}$"},
            "authorityProvider": {"$ref": "#/$defs/authority_provider"},
            "sourceBasis": {"$ref": "#/$defs/source_basis"},
            "providerProvenance": {"$ref": "#/$defs/provider_provenance"},
            "targetOperation": {"const": "materialize_architecture"},
            "direction": {"enum": ["none", "forward", "reverse"]},
            "useMode": {"enum": ["new", "historical"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "semantic_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticContractSetId", "authorityStateFingerprint"],
      "properties": {
        "semanticContractSetId": {"type": ["string", "null"]},
        "authorityStateFingerprint": {"type": ["string", "null"], "pattern": "^(asf:v1:sha256:[0-9a-f]{64})?$"}
      }
    },
    "limitation": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceContractRef", "semanticCapability", "classification"],
      "properties": {
        "sourceContractRef": {"$ref": "#/$defs/source_contract_binding"},
        "semanticCapability": {"type": "string", "minLength": 1},
        "classification": {"const": "not_expressible_by_source_contract"}
      }
    },
    "materialization_result_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "success", "outcome", "materializationContractVersion", "authorityProvider", "sourceBasis", "sourceContractClosure", "semanticBasis", "normalizedModel", "sourceCapabilityLimitations", "providerProvenance", "diagnostics"],
      "properties": {
        "operation": {"const": "materialize_architecture"},
        "success": {"type": "boolean"},
        "outcome": {"enum": ["Materialized", "Rejected", "Unavailable"]},
        "materializationContractVersion": {"const": "1.1"},
        "authorityProvider": {"anyOf": [{"$ref": "#/$defs/authority_provider"}, {"type": "null"}]},
        "sourceBasis": {"anyOf": [{"$ref": "#/$defs/source_basis"}, {"type": "null"}]},
        "sourceContractClosure": {"type": "array", "items": {"$ref": "#/$defs/source_contract_binding"}},
        "semanticBasis": {"$ref": "#/$defs/semantic_basis"},
        "normalizedModel": {"type": ["object", "null"], "description": "When non-null, this is the normalized-model@2.4 result; internal registries are not separate protocol fields."},
        "sourceCapabilityLimitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}},
        "providerProvenance": {"anyOf": [{"$ref": "#/$defs/provider_provenance"}, {"type": "null"}]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "materialization_request_envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["core_contract_version", "operation", "request"],
      "properties": {
        "core_contract_version": {"const": "1.3"},
        "operation": {"const": "materialize_architecture"},
        "request": {"$ref": "#/$defs/materialization_request_payload"}
      }
    },
    "materialization_result_envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["core_contract_version", "operation", "result"],
      "properties": {
        "core_contract_version": {"const": "1.3"},
        "operation": {"const": "materialize_architecture"},
        "result": {"$ref": "#/$defs/materialization_result_payload"}
      }
    },
    "invalid_result": {
      "type": "object", "additionalProperties": false,
      "required": ["core_contract_version", "operation", "success", "diagnostics"],
      "not": {"properties": {"operation": {"const": "materialize_architecture"}}},
      "properties": {
        "core_contract_version": {"const": "1.3"},
        "operation": {"type": "string", "minLength": 1},
        "success": {"const": false},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    }
  }
}
