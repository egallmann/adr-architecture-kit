{
  "projectRoot": ".",
  "languages": [
    "typescript"
  ],
  "sourceDirs": [
    "src"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.ste/**",
    "**/tests/**"
  ],
  "stateDir": ".ste-self/state",
  "watchdog": {
    "enabled": false
  },
  "mcp": {
    "transport": "stdio",
    "logLevel": "info"
  },
  "rss": {
    "defaultDepth": 2,
    "maxResults": 50
  }
}
