              },
              "additionalProperties": false
            },
            "authoring": {
              "$ref": "#/$defs/exact_authoring17_closure"
            },
            "normalized_model": {
              "$ref": "#/$defs/exact_nm24_closure"
            },
            "custom_entity": {
              "$ref": "#/$defs/exact_cec10_closure"
            }
          },
          "additionalProperties": false
        },
        "candidate_source_basis": {
          "type": "object",
