{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/entity-registry.schema.json",
  "title": "Entity Registry Schema",
  "description": "Canonical registry of all architecture entities across ADRs",
  
  "type": "object",
  "required": ["schema_version", "type", "entities"],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "type": {
      "const": "entity_registry"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "name", "introduced_by", "lifecycle_stage"],
        "properties": {
          "entity_id": {
            "$ref": "../v1.0/types.schema.json#/definitions/entity_id",
            "description": "Existing entity ID (CAP-XXXX, COMP-XXXX, etc.)"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "capability",
              "boundary",
              "contract",
              "constraint",
              "nfr",
              "decision",
              "gap",
              "component",
              "interface",
              "integration",
              "implementation_decision",
              "invariant"
            ]
          },
          "name": {
            "type": "string",
            "description": "Human-readable name"
          },
          "introduced_by": {
            "$ref": "../v1.0/types.schema.json#/definitions/adr_id_any",
            "description": "ADR that introduced this entity"
          },
          "lifecycle_stage": {
            "type": "string",
            "enum": ["proposed", "active", "deprecated", "superseded"],
            "description": "Current lifecycle stage"
          },
          "domains": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Business/technical domains"
          },
          "relationships": {
            "type": "object",
            "properties": {
              "depends_on": {
                "type": "array",
                "items": {"$ref": "../v1.0/types.schema.json#/definitions/entity_id"}
              },
              "implements": {
                "type": "array",
                "items": {"$ref": "../v1.0/types.schema.json#/definitions/entity_id"}
              },
              "consumes": {
                "type": "array",
                "items": {"$ref": "../v1.0/types.schema.json#/definitions/entity_id"}
              }
            },
            "description": "Forward relationships only (inverse derived)"
          }
        }
      }
    }
  }
}
