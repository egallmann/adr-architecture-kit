{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/semantic-contract/resources/authoring-construction/1.5/conformance.schema.json",
  "semanticDependencies": [
    "architecture-interpretation/1.5/required-output-derivations.schema"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_kind",
    "resource_version",
    "conformance_level",
    "authority_only",
    "runtime_execution_coverage",
    "semanticDependencies",
    "inherited_cases",
    "cases"
  ],
  "properties": {
    "resource_kind": {
      "const": "authoring-construction-conformance"
    },
    "resource_version": {
      "const": "1.5"
    },
    "conformance_level": {
      "const": "frozen_authority"
    },
    "authority_only": {
      "const": true
    },
    "runtime_execution_coverage": {
      "const": false
    },
    "semanticDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inherited_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "qualification",
          "preserved_assertions",
          "scope",
          "review"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^ACC14-[0-9]{3}$"
          },
          "qualification": {
            "$ref": "../../architecture-interpretation/1.5/required-output-derivations.schema.json#/$defs/qualified_resource"
          },
          "preserved_assertions": {
            "$ref": "#/$defs/assertions"
          },
          "scope": {
            "const": "historical_authority_only_not_executed_successor_request"
          },
          "review": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "category",
          "claim",
          "fixture",
          "assertions",
          "runtime_coverage"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^ACC15-[0-9]{3}$"
          },
          "category": {
            "enum": [
              "type_branch",
              "blocked_destination",
              "identity_recipe_definition",
              "literal_label_definition",
              "inherited_producer_definition",
              "recipe_exclusion",
              "recipe_authority",
              "selection",
              "negative_qualification",
              "construction_obligation"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "input"
            ],
            "properties": {
              "kind": {
                "const": "authority_reference"
              },
              "input": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "qualification": {
                    "$ref": "../../architecture-interpretation/1.5/required-output-derivations.schema.json#/$defs/qualified_resource"
                  },
                  "semantic_type": {
                    "type": "string"
                  },
                  "output_branch": {
                    "type": "string"
                  },
                  "destination": {
                    "type": "string"
                  },
                  "producer_kind": {
                    "type": "string"
                  },
                  "producer_rule": {
                    "$ref": "../../architecture-interpretation/1.5/required-output-derivations.schema.json#/$defs/qualified_resource"
                  },
                  "blocked_code": {
                    "type": "string"
                  },
                  "applicability": {
                    "const": "Unknown"
                  },
                  "fault": {
                    "type": "string"
                  },
                  "obligation": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "assertions": {
            "$ref": "#/$defs/assertions"
          },
          "runtime_coverage": {
            "const": "authority_only_not_implemented"
          }
        }
      }
    }
  },
  "$defs": {
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "operator",
          "expected"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "equals",
              "contains",
              "excludes",
              "set_equals",
              "multiset_equals",
              "schema_valid",
              "outcome_is",
              "authority_is"
            ]
          },
          "expected": {}
        },
        "additionalProperties": false
      }
    }
  }
}
