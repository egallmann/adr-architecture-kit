{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ste.design_journal.promotion_contract/v0.1/schema.json",
  "title": "STE Design Journal Promotion Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "design_journal_version",
    "journal_id",
    "lifecycle_state",
    "outcomes",
    "mutations",
    "blockers"
  ],
  "properties": {
    "contract_version": {
      "const": "ste.design_journal.promotion_contract/v0.1"
    },
    "design_journal_version": {
      "const": "ste.design_journal/v0.1"
    },
    "journal_id": { "type": "string", "minLength": 1 },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "exploring",
        "converging",
        "lock_ready",
        "locked",
        "promoting",
        "promoted",
        "closed"
      ]
    },
    "provider": { "type": ["string", "null"], "minLength": 1 },
    "authority_baseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "kind", "value"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "source_artifact_revision": { "type": "string" },
    "outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/outcome" }
    },
    "mutations": {
      "type": "array",
      "items": { "$ref": "#/$defs/mutation" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_lock": { "type": "boolean" },
        "mechanical_promotion": { "type": "boolean" }
      }
    },
    "human_lock": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/human_lock" }
      ]
    },
    "execution_evidence": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]+$"
        },
        "immutable_revision": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["fingerprint"] },
        { "required": ["immutable_revision"] }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "promotion_required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "promotion_required": { "type": "boolean" },
        "disposition": { "type": "string" },
        "statement": { "type": "string", "minLength": 1 },
        "semantic_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "fingerprint"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]+$"
            }
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "provider",
        "provider_target_ref",
        "outcome_refs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation": {
          "type": "string",
          "enum": ["create", "amend", "supersede"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "provider_target_ref": { "type": "string", "minLength": 1 },
        "outcome_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "payload_binding": { "$ref": "#/$defs/binding" },
        "schema_binding": { "$ref": "#/$defs/binding" },
        "validation_evidence": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "payload_fingerprint",
            "schema_binding_fingerprint",
            "result"
          ],
          "properties": {
            "payload_fingerprint": { "type": "string" },
            "schema_binding_fingerprint": { "type": "string" },
            "result": { "type": "string" },
            "evidence_ref": { "type": "string" }
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "human_lock": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "approved",
        "approver",
        "approved_at",
        "journal_id",
        "locked_intent_fingerprint"
      ],
      "properties": {
        "approved": { "const": true },
        "approver": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 },
        "journal_id": { "type": "string", "minLength": 1 },
        "source_artifact_revision": { "type": "string" },
        "locked_intent_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]+$"
        },
        "authority_baseline": { "type": "object" },
        "promotion_scope": { "type": "object" },
        "payload_bindings": { "type": "array" },
        "schema_bindings": { "type": "array" }
      }
    }
  }
}
