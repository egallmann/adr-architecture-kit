{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/semantic-contract/resources/authoring-construction/1.3/schema.json",
  "title": "ADR-Kit Authoring Construction Contract 1.3 shape",
  "description": "Strict host-neutral wire shape for ACC requests, diagnostics, operation-specific results, and exact authority qualification.",
  "oneOf": [
    {
      "$ref": "#/$defs/contract_document"
    },
    {
      "$ref": "#/$defs/authoring_request"
    },
    {
      "$ref": "#/$defs/validation_result"
    },
    {
      "$ref": "#/$defs/construction_result"
    }
  ],
  "$defs": {
    "non_empty": {
      "$ref": "../1.1/schema.json#/$defs/non_empty"
    },
    "uuid_v7": {
      "$ref": "../1.1/schema.json#/$defs/uuid_v7"
    },
    "digest": {
      "$ref": "../1.1/schema.json#/$defs/digest"
    },
    "scf": {
      "$ref": "../1.1/schema.json#/$defs/scf"
    },
    "cecf": {
      "$ref": "../1.1/schema.json#/$defs/cecf"
    },
    "semantic_type": {
      "$ref": "../1.1/schema.json#/$defs/semantic_type"
    },
    "resource_member": {
      "$ref": "../1.1/schema.json#/$defs/resource_member"
    },
    "semantic_contract_qualification": {
      "$ref": "../1.1/schema.json#/$defs/semantic_contract_qualification"
    },
    "architecture_interpretation_qualification": {
      "type": "object",
      "required": [
        "family",
        "version",
        "semantic_contract_fingerprint",
        "authority_closure"
      ],
      "properties": {
        "family": {
          "const": "architecture-interpretation"
        },
        "version": {
          "const": "1.3"
        },
        "semantic_contract_fingerprint": {
          "const": "scf:v1:sha256:d4a60e843c3069cfd7eb869a4d924d3a70bf900079d3a2ad86ae28884c6ac167"
        },
        "authority_closure": {
          "$ref": "#/$defs/exact_ai13_closure"
        }
      },
      "additionalProperties": false
    },
    "exact_resource_set_qualification": {
      "$ref": "../1.1/schema.json#/$defs/exact_resource_set_qualification"
    },
    "custom_qualification": {
      "$ref": "../1.1/schema.json#/$defs/custom_qualification"
    },
    "custom_definition_qualification": {
      "$ref": "../1.1/schema.json#/$defs/custom_definition_qualification"
    },
    "custom_registry_qualification": {
      "$ref": "../1.1/schema.json#/$defs/custom_registry_qualification"
    },
    "fragment_qualification": {
      "$ref": "../1.1/schema.json#/$defs/fragment_qualification"
    },
    "exact_source_descriptor": {
      "$ref": "../1.1/schema.json#/$defs/exact_source_descriptor"
    },
    "fragment_reference": {
      "$ref": "../1.1/schema.json#/$defs/fragment_reference"
    },
    "fragment_intent": {
      "$ref": "../1.1/schema.json#/$defs/fragment_intent"
    },
    "composition_intent": {
      "$ref": "../1.1/schema.json#/$defs/composition_intent"
    },
    "endpoint": {
      "$ref": "../1.1/schema.json#/$defs/endpoint"
    },
    "relationship_intent": {
      "$ref": "../1.1/schema.json#/$defs/relationship_intent"
    },
    "reference_entry": {
      "$ref": "../1.1/schema.json#/$defs/reference_entry"
    },
    "reference_basis": {
      "$ref": "../1.1/schema.json#/$defs/reference_basis"
    },
    "existing_source_entry": {
      "$ref": "../1.1/schema.json#/$defs/existing_source_entry"
    },
    "existing_source_basis": {
      "$ref": "../1.1/schema.json#/$defs/existing_source_basis"
    },
    "identity_establishment_policy": {
      "$ref": "../1.1/schema.json#/$defs/identity_establishment_policy"
    },
    "exact_basis": {
      "type": "object",
      "required": [
        "acc",
        "adc",
        "authoring",
        "normalized_model",
        "architecture_interpretation",
        "custom_entity",
        "reference_basis",
        "existing_source_basis",
        "identity_establishment",
        "provenance"
      ],
      "properties": {
        "acc": {
          "$ref": "#/$defs/acc13_qualification"
        },
        "adc": {
          "$ref": "#/$defs/exact_resource_set_qualification"
        },
        "authoring": {
          "$ref": "#/$defs/exact_authoring17_closure"
        },
        "normalized_model": {
          "$ref": "#/$defs/exact_nm25_closure"
        },
        "architecture_interpretation": {
          "$ref": "#/$defs/architecture_interpretation_qualification"
        },
        "custom_entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/custom_registry_qualification"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_basis": {
          "$ref": "#/$defs/reference_basis"
        },
        "existing_source_basis": {
          "$ref": "#/$defs/existing_source_basis"
        },
        "identity_establishment": {
          "$ref": "#/$defs/identity_establishment_policy"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "authoring_request": {
      "type": "object",
      "required": [
        "contract_family",
        "contract_version",
        "operation",
        "request",
        "basis"
      ],
      "properties": {
        "contract_family": {
          "const": "authoring_construction"
        },
        "contract_version": {
          "const": "1.3"
        },
        "operation": {
          "enum": [
            "validate_authoring",
            "construct_authoring_set"
          ]
        },
        "request": {
          "type": "object",
          "required": [
            "request_id",
            "fragments",
            "compositions",
            "relationships"
          ],
          "properties": {
            "request_id": {
              "$ref": "#/$defs/non_empty"
            },
            "fragments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fragment_intent"
              }
            },
            "compositions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/composition_intent"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relationship_intent"
              }
            }
          },
          "additionalProperties": false
        },
        "basis": {
          "$ref": "#/$defs/exact_basis"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "$ref": "../1.1/schema.json#/$defs/diagnostic"
    },
    "basis_qualification": {
      "$ref": "#/$defs/exact_basis"
    },
    "construction_map_entry": {
      "$ref": "../1.1/schema.json#/$defs/construction_map_entry"
    },
    "resolved_reference": {
      "$ref": "../1.1/schema.json#/$defs/resolved_reference"
    },
    "source_schema": {
      "$ref": "../1.1/schema.json#/$defs/source_schema"
    },
    "candidate_artifact": {
      "$ref": "../1.1/schema.json#/$defs/candidate_artifact"
    },
    "candidate_source_basis": {
      "$ref": "../1.1/schema.json#/$defs/candidate_source_basis"
    },
    "normalized_result": {
      "type": "object",
      "required": [
        "normalized_contract",
        "semantic_digest",
        "model"
      ],
      "properties": {
        "normalized_contract": {
          "$ref": "#/$defs/exact_nm25_closure"
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "model": {
          "$ref": "../../normalized-model/2.5/schema/normalized-architecture-model.schema.json"
        }
      },
      "additionalProperties": false
    },
    "round_trip": {
      "$ref": "../1.1/schema.json#/$defs/round_trip"
    },
    "result_base": {
      "type": "object",
      "required": [
        "contract_family",
        "contract_version",
        "operation",
        "basis_qualification",
        "diagnostics",
        "provenance"
      ],
      "properties": {
        "contract_family": {
          "const": "authoring_construction"
        },
        "contract_version": {
          "const": "1.3"
        },
        "operation": {
          "enum": [
            "validate_authoring",
            "construct_authoring_set"
          ]
        },
        "basis_qualification": {
          "$ref": "#/$defs/basis_qualification"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "validation_result": {
      "allOf": [
        {
          "$ref": "#/$defs/result_base"
        },
        {
          "type": "object",
          "required": [
            "operation",
            "validation_status"
          ],
          "properties": {
            "operation": {
              "const": "validate_authoring"
            },
            "validation_status": {
              "enum": [
                "valid",
                "invalid",
                "unavailable",
                "unresolved"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "construction_result": {
      "allOf": [
        {
          "$ref": "#/$defs/result_base"
        },
        {
          "type": "object",
          "required": [
            "operation",
            "outcome",
            "construction_map",
            "candidate_fragments",
            "candidate_artifacts",
            "candidate_source_basis",
            "normalized_result",
            "round_trip",
            "construction_qualification",
            "composition_records"
          ],
          "properties": {
            "operation": {
              "const": "construct_authoring_set"
            },
            "outcome": {
              "enum": [
                "Constructed",
                "Rejected",
                "Unavailable",
                "Unresolved"
              ]
            },
            "construction_map": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/construction_map_entry"
              }
            },
            "candidate_fragments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "request_key",
                  "semantic_kind",
                  "semantic_type",
                  "identity",
                  "contract_qualification",
                  "fields",
                  "source_contract"
                ],
                "properties": {
                  "request_key": {
                    "$ref": "#/$defs/non_empty"
                  },
                  "semantic_kind": {
                    "enum": [
                      "adr",
                      "entity",
                      "relationship",
                      "value"
                    ]
                  },
                  "semantic_type": {
                    "$ref": "#/$defs/semantic_type"
                  },
                  "identity": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/uuid_v7"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "contract_qualification": {
                    "$ref": "#/$defs/fragment_qualification"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "resolved_references": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/resolved_reference"
                    }
                  },
                  "source_contract": {
                    "$ref": "#/$defs/exact_resource_set_qualification"
                  }
                },
                "additionalProperties": false
              }
            },
            "candidate_artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/candidate_artifact"
              }
            },
            "candidate_source_basis": {
              "anyOf": [
                {
                  "$ref": "#/$defs/candidate_source_basis"
                },
                {
                  "type": "null"
                }
              ]
            },
            "normalized_result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/normalized_result"
                },
                {
                  "type": "null"
                }
              ]
            },
            "round_trip": {
              "$ref": "#/$defs/round_trip"
            },
            "construction_qualification": {
              "anyOf": [
                {
                  "$ref": "#/$defs/construction_qualification"
                },
                {
                  "type": "null"
                }
              ]
            },
            "composition_records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/composition_record"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "Constructed"
              }
            }
          },
          "then": {
            "required": [
              "candidate_source_basis",
              "normalized_result",
              "construction_qualification"
            ],
            "properties": {
              "candidate_source_basis": {
                "$ref": "#/$defs/candidate_source_basis"
              },
              "normalized_result": {
                "$ref": "#/$defs/normalized_result"
              },
              "round_trip": {
                "properties": {
                  "qualified": {
                    "const": true
                  },
                  "comparison": {
                    "const": "semantic_equivalent"
                  }
                }
              },
              "construction_qualification": {
                "$ref": "#/$defs/construction_qualification",
                "properties": {
                  "interpretation": {
                    "properties": {
                      "status": {
                        "const": "complete"
                      }
                    }
                  },
                  "normalized_model": {
                    "properties": {
                      "schema_validation": {
                        "const": "valid"
                      }
                    }
                  },
                  "comparison": {
                    "properties": {
                      "status": {
                        "const": "semantic_equivalent"
                      },
                      "complete": {
                        "const": true
                      },
                      "all_expected_accounted": {
                        "const": true
                      },
                      "all_observed_accounted": {
                        "const": true
                      },
                      "mismatches": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "contract_document": {
      "type": "object",
      "required": [
        "semanticContractFamily",
        "semanticContractVersion",
        "fingerprintScheme",
        "resourceManifest",
        "frozenNormativeConformanceResources",
        "semanticContractFingerprint"
      ],
      "properties": {
        "semanticContractFamily": {
          "const": "authoring-construction"
        },
        "semanticContractVersion": {
          "const": "1.3"
        },
        "fingerprintScheme": {
          "const": "scf:v1:sha256"
        },
        "resourceManifest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource_manifest_entry"
          }
        },
        "frozenNormativeConformanceResources": {
          "const": [
            "authoring-construction/1.3/conformance"
          ]
        },
        "semanticContractFingerprint": {
          "$ref": "#/$defs/scf"
        }
      },
      "additionalProperties": false
    },
    "resource_manifest_entry": {
      "type": "object",
      "required": [
        "canonicalResourceKey",
        "contentDigest",
        "role",
        "dependencies"
      ],
      "properties": {
        "canonicalResourceKey": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[0-9]+\\.[0-9]+/[a-z0-9._/-]+$"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "enum": [
            "source-contract-mapping",
            "source-contract-schema",
            "interpretation-rule",
            "interpretation-conformance",
            "normative-definition",
            "normative-conformance",
            "normalized-model-schema",
            "normalized-model-conformance"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_dependency"
          }
        }
      },
      "additionalProperties": false
    },
    "resource_dependency": {
      "$ref": "../1.1/schema.json#/$defs/resource_dependency"
    },
    "construction_qualification": {
      "type": "object",
      "required": [
        "authority",
        "candidate_source_basis",
        "interpretation",
        "normalized_model",
        "expected_ledger",
        "observed_ledger",
        "comparison"
      ],
      "properties": {
        "authority": {
          "type": "object",
          "required": [
            "architecture_interpretation",
            "authoring_domain",
            "authoring",
            "normalized_model",
            "custom_entity",
            "acc",
            "composition_binding"
          ],
          "properties": {
            "architecture_interpretation": {
              "type": "object",
              "required": [
                "family",
                "version",
                "semantic_contract_fingerprint",
                "authority_closure"
              ],
              "properties": {
                "family": {
                  "const": "architecture-interpretation"
                },
                "version": {
                  "const": "1.3"
                },
                "semantic_contract_fingerprint": {
                  "const": "scf:v1:sha256:d4a60e843c3069cfd7eb869a4d924d3a70bf900079d3a2ad86ae28884c6ac167"
                },
                "authority_closure": {
                  "$ref": "#/$defs/exact_ai13_closure"
                }
              },
              "additionalProperties": false
            },
            "authoring_domain": {
              "type": "object",
              "required": [
                "contract_id",
                "version",
                "content_digest"
              ],
              "properties": {
                "contract_id": {
                  "const": "adr-kit.authoring-domain"
                },
                "version": {
                  "const": "1.1"
                },
                "content_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "additionalProperties": false
            },
            "authoring": {
              "$ref": "#/$defs/exact_authoring17_closure"
            },
            "normalized_model": {
              "$ref": "#/$defs/exact_nm25_closure"
            },
            "custom_entity": {
              "$ref": "#/$defs/exact_cec10_closure"
            },
            "acc": {
              "$ref": "#/$defs/acc13_qualification"
            },
            "composition_binding": {
              "$ref": "#/$defs/composition_binding_qualification"
            }
          },
          "additionalProperties": false
        },
        "candidate_source_basis": {
          "type": "object",
          "required": [
            "basis_digest",
            "selected_root_source_refs",
            "minimality"
          ],
          "properties": {
            "basis_digest": {
              "$ref": "#/$defs/digest"
            },
            "selected_root_source_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/non_empty"
              }
            },
            "minimality": {
              "const": "verified"
            }
          },
          "additionalProperties": false
        },
        "interpretation": {
          "type": "object",
          "required": [
            "status",
            "input_basis_digest",
            "architecture_interpretation_fingerprint"
          ],
          "properties": {
            "status": {
              "const": "complete"
            },
            "input_basis_digest": {
              "$ref": "#/$defs/digest"
            },
            "architecture_interpretation_fingerprint": {
              "const": "scf:v1:sha256:d4a60e843c3069cfd7eb869a4d924d3a70bf900079d3a2ad86ae28884c6ac167"
            }
          },
          "additionalProperties": false
        },
        "normalized_model": {
          "type": "object",
          "required": [
            "schema_validation",
            "normalized_contract"
          ],
          "properties": {
            "schema_validation": {
              "const": "valid"
            },
            "normalized_contract": {
              "$ref": "#/$defs/exact_nm25_closure"
            }
          },
          "additionalProperties": false
        },
        "expected_ledger": {
          "$ref": "ledger.schema.json"
        },
        "observed_ledger": {
          "$ref": "ledger.schema.json"
        },
        "comparison": {
          "type": "object",
          "required": [
            "algorithm",
            "status",
            "complete",
            "all_expected_accounted",
            "all_observed_accounted",
            "mismatches"
          ],
          "properties": {
            "algorithm": {
              "const": "authoring-construction/1.1/complete-semantic-ledger-equality"
            },
            "status": {
              "enum": [
                "semantic_equivalent",
                "semantic_mismatch",
                "not_evaluated"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "all_expected_accounted": {
              "type": "boolean"
            },
            "all_observed_accounted": {
              "type": "boolean"
            },
            "mismatches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/semantic_mismatch_diagnostic"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "semantic_mismatch_diagnostic": {
      "$ref": "../1.1/schema.json#/$defs/semantic_mismatch_diagnostic"
    },
    "exact_ai13_closure": {
      "type": "object",
      "required": [
        "family",
        "version",
        "resources"
      ],
      "properties": {
        "family": {
          "const": "architecture-interpretation"
        },
        "version": {
          "const": "1.3"
        },
        "resources": {
          "type": "array",
          "minItems": 52,
          "maxItems": 52,
          "uniqueItems": true,
          "items": {
            "enum": [
              {
                "canonical_resource_key": "architecture-interpretation/1.0/source-decoding-1.5",
                "content_digest": "sha256:d7f0b0547e8e8f1347d2320870bb7d3b30c08a8d44e7d54dd52c58343cc345cc"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.0/source-decoding-1.6",
                "content_digest": "sha256:bffca76b59a76955213386b0c6e5d2cabe8c1a418d1793d39b51d57b7dffbdcc"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.0/source-mapping-1.5-to-2.3",
                "content_digest": "sha256:b0bdc462bdf7187f67fe74045eb8fc98dcb80a7703980cf41a64e529be314d78"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.0/source-mapping-1.6-to-2.3",
                "content_digest": "sha256:be647e09f4b1d2d6007dd020c651f228a98a7138f9c0da12d7d3f2f2c488c23e"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.2/legacy-compatibility",
                "content_digest": "sha256:3e8bb04719f92d0b74aff21e0e84c9e31f88ac71acbf709dc61e0e2c02ed0ef5"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.2/source-decoding-1.7",
                "content_digest": "sha256:53fe192a1870ce923cbbe14e810c132baa8ecbe1f60d6632d072b0732d43a6b2"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.3/conformance",
                "content_digest": "sha256:62e124047c59dbf2ad6321cbbef5d4626085cc101e2f6cababeeccb1417d3fea"
              },
              {
                "canonical_resource_key": "architecture-interpretation/1.3/conformance.schema",
