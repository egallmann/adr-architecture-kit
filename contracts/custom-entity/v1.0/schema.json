{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.ste.systems/contracts/custom-entity/v1.0/schema.json",
  "title": "ADR-Kit Custom Entity Contract 1.0 shape",
  "description": "Structural validation for the descriptive, read-only Custom Entity Contract 1.0 and its exact consumer-qualified registry entries.",
  "oneOf": [
    {"$ref": "#/$defs/contract_document"},
    {"$ref": "#/$defs/registry_document"}
  ],
  "$defs": {
    "qualified_type": {
      "type": "object",
      "required": ["semantic_kind", "semantic_type", "consumer_namespace", "contract_version", "contract_fingerprint"],
      "properties": {
        "semantic_kind": {"enum": ["entity", "relationship"]},
        "semantic_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"},
        "consumer_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "contract_fingerprint": {"$ref": "#/$defs/fingerprint"}
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"
    },
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scalar_type": {
      "enum": ["string", "integer", "number", "boolean"]
    },
    "field_definition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"$ref": "#/$defs/scalar_type"},
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": ["string", "integer", "number", "boolean"]}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "items", "max_items"],
          "properties": {
            "type": {"const": "array"},
            "items": {"$ref": "#/$defs/scalar_type"},
            "max_items": {"type": "integer", "minimum": 1, "maximum": 64},
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": ["string", "integer", "number", "boolean"]}
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "max_properties", "key_pattern", "value_types"],
          "properties": {
            "type": {"const": "bounded_property_map"},
            "max_properties": {"type": "integer", "minimum": 0, "maximum": 128},
            "key_pattern": {"const": "^[a-z][a-z0-9_]{0,63}$"},
            "value_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/scalar_type"}
            },
            "array_max_items": {"type": "integer", "minimum": 1, "maximum": 64},
            "unknown_property_policy": {"const": "reject"},
            "nested_objects": {"const": false}
          },
          "additionalProperties": false
        }
      ]
    },
    "field_contract": {
      "type": "object",
      "required": ["required_fields", "optional_fields", "forbidden_fields", "unknown_field_policy", "fields"],
      "properties": {
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_name"}},
        "optional_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_name"}},
        "forbidden_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/field_name"}},
        "unknown_field_policy": {"const": "reject"},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {"^[a-z][a-z0-9_]{0,63}$": {"$ref": "#/$defs/field_definition"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "field_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "identity_policy": {
      "type": "object",
      "required": ["mode", "identity_bearing", "supplied_identity", "establishment", "update_identity", "reference_identity", "composition_identity", "forbidden_derivations"],
      "properties": {
        "mode": {"const": "canonical_uuidv7"},
        "identity_bearing": {"const": true},
        "supplied_identity": {"const": "preserve"},
        "establishment": {"const": "create_when_absent"},
        "update_identity": {"const": "preserve"},
        "reference_identity": {"const": "reuse"},
        "composition_identity": {"const": "does_not_manufacture"},
        "forbidden_derivations": {
          "type": "array",
          "uniqueItems": true,
          "contains": {"const": "alias"},
          "items": {"enum": ["alias", "prose", "path", "hash", "source_location", "ordering", "composition_position"]}
        }
      },
      "additionalProperties": false
    },
    "alias_policy": {
      "type": "object",
      "required": ["fields", "orientation", "allocation_authority", "reservation", "canonical_foreign_key"],
      "properties": {
        "fields": {"const": ["alias_id", "alias_name"]},
        "orientation": {"const": "alias_id_stable_name_descriptive"},
        "allocation_authority": {"const": "consumer"},
        "reservation": {"const": "outside_construction"},
        "canonical_foreign_key": {"const": false},
        "shape": {"type": "object", "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "composition_policy": {
      "type": "object",
      "required": ["allowed_parents", "minimum", "maximum", "identity_effect", "admission_effect"],
      "properties": {
        "allowed_parents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["adr/logical", "adr/physical-system", "adr/physical-component"]}
        },
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": ["integer", "null"], "minimum": 0},
        "identity_effect": {"const": "does_not_manufacture_identity"},
        "admission_effect": {"const": "does_not_imply_governance_admission"}
      },
      "additionalProperties": false
    },
    "existence_policy": {
      "type": "object",
      "required": ["field", "values", "semantic_dimension", "retire_effect"],
      "properties": {
        "field": {"const": "existence_state"},
        "values": {"const": ["active", "retired"]},
        "semantic_dimension": {"const": "adr_kit_generic_existence"},
        "retire_effect": {"const": "preserve_identity_and_historical_interpretation"}
      },
      "additionalProperties": false
    },
    "consumer_state_policy": {
      "type": "object",
      "required": ["separate_from_existence", "field_authority", "replacement_of_existence_state"],
      "properties": {
        "separate_from_existence": {"const": true},
        "field_authority": {"const": "consumer_contract"},
        "replacement_of_existence_state": {"const": false},
        "examples": {"type": "array", "items": {"$ref": "#/$defs/field_name"}}
      },
      "additionalProperties": false
    },
    "endpoint_type": {
      "type": "object",
      "required": ["endpoint_kind", "semantic_type"],
      "properties": {
        "endpoint_kind": {"enum": ["canonical_entity", "qualified_custom_type"]},
        "semantic_type": {
          "type": "string",
          "pattern": "^(?:entity/[a-z][a-z0-9_]*|[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63})$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"endpoint_kind": {"const": "canonical_entity"}}},
          "then": {"properties": {"semantic_type": {"pattern": "^entity/[a-z][a-z0-9_]*$"}}}
        },
        {
          "if": {"properties": {"endpoint_kind": {"const": "qualified_custom_type"}}},
          "then": {"properties": {"semantic_type": {"pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"}}}
        }
      ],
      "additionalProperties": false
    },
    "reference_policy": {
      "type": "object",
      "required": ["mode", "allowed_reference_kinds", "reference_fields", "endpoint_representation", "resolution", "unresolved", "aliases_as_endpoints"],
      "properties": {
        "mode": {"const": "canonical_uuidv7"},
        "allowed_reference_kinds": {"const": ["canonical_entity", "qualified_custom_type"]},
        "reference_fields": {"const": ["from_entity_id", "to_entity_id"]},
        "endpoint_representation": {"const": "canonical_uuidv7"},
        "resolution": {"const": "exact_identity_basis"},
        "unresolved": {"const": "reject"},
        "aliases_as_endpoints": {"const": false}
      },
      "additionalProperties": false
    },
    "relationship_participation": {
      "type": "object",
      "required": ["outbound", "inbound", "inverse_inference"],
      "properties": {
        "outbound": {"type": "array", "items": {"$ref": "#/$defs/participation"}},
        "inbound": {"type": "array", "items": {"$ref": "#/$defs/participation"}},
        "inverse_inference": {"const": "forbidden_without_declared_inverse"}
      },
      "additionalProperties": false
    },
    "participation": {
      "type": "object",
      "required": ["relationship_type", "target_types", "minimum", "maximum", "ordering"],
      "properties": {
        "relationship_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"},
        "target_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/endpoint_type"}},
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": ["integer", "null"], "minimum": 0},
        "ordering": {"enum": ["not_material", "material_contract_declared"]}
      },
      "additionalProperties": false
    },
    "cardinality": {
      "type": "object",
      "required": ["mode", "minimum", "maximum"],
      "properties": {
        "mode": {"const": "custom_contract_declared"},
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "ordering": {
      "type": "object",
      "required": ["mode", "materiality", "rule"],
      "properties": {
        "mode": {"const": "contract_declared"},
        "materiality": {"enum": ["not_material", "material_when_declared"]},
        "rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "property_policy": {
      "type": "object",
      "required": ["value_semantics", "unknown_property_policy", "nested_objects", "relationship_effect"],
      "properties": {
        "value_semantics": {"const": "bounded_scalar_or_scalar_array"},
        "unknown_property_policy": {"const": "reject"},
        "nested_objects": {"const": false},
        "relationship_effect": {"const": "never_implies_graph_relationship"},
        "max_properties": {"type": "integer", "minimum": 0, "maximum": 128},
        "array_max_items": {"type": "integer", "minimum": 1, "maximum": 64}
      },
      "additionalProperties": false
    },
    "operation_posture": {
      "type": "object",
      "required": ["create", "update", "reference", "retire"],
      "properties": {
        "create": {"$ref": "#/$defs/operation"},
        "update": {"$ref": "#/$defs/operation"},
        "reference": {"$ref": "#/$defs/operation"},
        "retire": {"$ref": "#/$defs/operation"}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["status", "permission", "execution", "persistence", "alias_reservation"],
      "properties": {
        "status": {"const": "descriptive_not_executable"},
        "permission": {"enum": ["qualified_contract_required", "read_only_reference", "unsupported"]},
        "execution": {"const": false},
        "persistence": {"const": "outside_contract_definition"},
        "alias_reservation": {"const": "outside_construction"}
      },
      "additionalProperties": false
    },
    "entity_definition": {
      "type": "object",
      "required": ["semantic_kind", "semantic_type", "consumer_namespace", "contract_version", "contract_fingerprint", "description", "identity_policy", "alias_policy", "field_contract", "composition_policy", "existence_policy", "consumer_state_policy", "relationship_participation", "reference_policy", "operation_posture"],
      "properties": {
        "semantic_kind": {"const": "entity"},
        "semantic_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"},
        "consumer_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "contract_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "identity_policy": {"$ref": "#/$defs/identity_policy"},
        "alias_policy": {"$ref": "#/$defs/alias_policy"},
        "field_contract": {"$ref": "#/$defs/field_contract"},
        "composition_policy": {"$ref": "#/$defs/composition_policy"},
        "existence_policy": {"$ref": "#/$defs/existence_policy"},
        "consumer_state_policy": {"$ref": "#/$defs/consumer_state_policy"},
        "relationship_participation": {"$ref": "#/$defs/relationship_participation"},
        "reference_policy": {"$ref": "#/$defs/entity_reference_policy"},
        "operation_posture": {"$ref": "#/$defs/operation_posture"}
      },
      "additionalProperties": false
    },
    "entity_reference_policy": {
      "type": "object",
      "required": ["identity_representation", "resolution", "unresolved", "aliases_as_identity"],
      "properties": {
        "identity_representation": {"const": "canonical_uuidv7"},
        "resolution": {"const": "exact_identity_basis"},
        "unresolved": {"const": "reject"},
        "aliases_as_identity": {"const": false}
      },
      "additionalProperties": false
    },
    "relationship_definition": {
      "type": "object",
      "required": ["semantic_kind", "semantic_type", "consumer_namespace", "contract_version", "contract_fingerprint", "description", "relationship_mode", "identity_policy", "alias_policy", "field_contract", "reference_policy", "source_types", "target_types", "property_policy", "rationale", "cardinality", "ordering", "operation_posture"],
      "properties": {
        "semantic_kind": {"const": "relationship"},
        "semantic_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"},
        "consumer_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "contract_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "relationship_mode": {"const": "custom_explicit"},
        "identity_policy": {"$ref": "#/$defs/identity_policy"},
        "alias_policy": {"$ref": "#/$defs/alias_policy"},
        "field_contract": {"$ref": "#/$defs/field_contract"},
        "reference_policy": {"$ref": "#/$defs/reference_policy"},
        "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/endpoint_type"}},
        "target_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/endpoint_type"}},
        "property_policy": {"$ref": "#/$defs/property_policy"},
        "rationale": {"enum": ["required", "optional", "forbidden"]},
        "cardinality": {"$ref": "#/$defs/cardinality"},
        "ordering": {"$ref": "#/$defs/ordering"},
        "operation_posture": {"$ref": "#/$defs/operation_posture"}
      },
      "additionalProperties": false
    },
    "custom_definition": {
      "oneOf": [
        {"$ref": "#/$defs/entity_definition"},
        {"$ref": "#/$defs/relationship_definition"}
      ]
    },
    "registry_document": {
      "type": "object",
      "required": ["registry_id", "registry_version", "authority", "definitions", "selection_policy", "exact_selection"],
      "properties": {
        "registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "registry_version": {"const": "1.0"},
        "authority": {"const": "consumer_namespace"},
        "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/custom_definition"}},
        "selection_policy": {"$ref": "#/$defs/selection_policy"},
        "exact_selection": {"$ref": "#/$defs/selection"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["semantic_kind", "semantic_type", "contract_version", "contract_fingerprint"],
      "properties": {
        "semantic_kind": {"enum": ["entity", "relationship"]},
        "semantic_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9_]{1,63}$"},
        "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "contract_fingerprint": {"$ref": "#/$defs/fingerprint"}
      },
      "additionalProperties": false
    },
    "selection_policy": {
      "type": "object",
      "required": ["mode", "latest", "missing_exact_authority", "ambiguous_duplicate", "ordering"],
      "properties": {
        "mode": {"const": "exact_qualified_selection"},
        "latest": {"const": "forbidden"},
        "missing_exact_authority": {"const": "reject"},
        "ambiguous_duplicate": {"const": "reject"},
        "ordering": {"const": "canonical_semantic_json"}
      },
      "additionalProperties": false
    },
    "contract_document": {
      "type": "object",
      "required": ["$schema", "$id", "contract_id", "contract_version", "contract_family", "status", "title", "description", "qualification_policy", "fingerprint_policy", "registry_policy", "identity_policy", "alias_policy", "field_policy", "composition_policy", "relationship_policy", "operation_semantics", "migration_policy", "canonical_promotion_policy", "validation_authority_ceiling", "read_only_boundary", "excluded_from_version", "successor_notes"],
      "properties": {
        "$schema": {"const": "./schema.json"},
        "$id": {"const": "https://adr-kit.ste.systems/contracts/custom-entity/v1.0/contract.json"},
        "contract_id": {"const": "adr-kit.custom-entity"},
        "contract_version": {"const": "1.0"},
        "contract_family": {"const": "custom_entity"},
        "status": {"const": "descriptive_read_only"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "qualification_policy": {"$ref": "#/$defs/qualification_policy"},
        "fingerprint_policy": {"$ref": "#/$defs/fingerprint_policy"},
        "registry_policy": {"$ref": "#/$defs/registry_policy"},
        "identity_policy": {"$ref": "#/$defs/contract_identity_policy"},
        "alias_policy": {"$ref": "#/$defs/contract_alias_policy"},
        "field_policy": {"$ref": "#/$defs/contract_field_policy"},
        "composition_policy": {"$ref": "#/$defs/contract_composition_policy"},
        "relationship_policy": {"$ref": "#/$defs/contract_relationship_policy"},
        "operation_semantics": {"$ref": "#/$defs/contract_operation_policy"},
        "migration_policy": {"$ref": "#/$defs/migration_policy"},
        "canonical_promotion_policy": {"$ref": "#/$defs/promotion_policy"},
        "validation_authority_ceiling": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "read_only_boundary": {"$ref": "#/$defs/read_only_boundary"},
        "excluded_from_version": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "successor_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "qualification_policy": {
      "type": "object",
      "required": ["semantic_kinds", "semantic_type_format", "required_components", "path_identity", "ambient_defaults", "latest_selection"],
      "properties": {
        "semantic_kinds": {"const": ["entity", "relationship"]},
        "semantic_type_format": {"const": "consumer_namespace:local_name"},
        "required_components": {"const": ["semantic_kind", "semantic_type", "consumer_namespace", "contract_version", "contract_fingerprint"]},
        "path_identity": {"const": false},
        "ambient_defaults": {"const": false},
        "latest_selection": {"const": false}
      },
      "additionalProperties": false
    },
    "fingerprint_policy": {
      "type": "object",
      "required": ["scheme", "algorithm", "canonicalization", "preimage", "self_reference", "deterministic_replay", "meaning_affecting_changes"],
      "properties": {
        "scheme": {"const": "scf:v1:sha256"},
        "algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "repository_canonical_semantic_json"},
        "preimage": {"const": "all_meaning_affecting_contract_content_except_contract_fingerprint"},
        "self_reference": {"const": "contract_fingerprint_excluded_from_own_preimage"},
        "deterministic_replay": {"const": true},
        "meaning_affecting_changes": {"const": "change_fingerprint"}
      },
      "additionalProperties": false
    },
    "registry_policy": {
      "type": "object",
      "required": ["is_semantic_input", "authority", "supports_multiple_types", "retained_versions", "selection", "duplicate_rule", "ordering", "global_registry", "historical_interpretation"],
      "properties": {
        "is_semantic_input": {"const": true},
        "authority": {"const": "consumer_namespace"},
        "supports_multiple_types": {"const": true},
        "retained_versions": {"const": "explicit_historical_versions"},
        "selection": {"const": "exact_type_kind_version_fingerprint"},
        "duplicate_rule": {"const": "same_qualification_same_contract; differing_fingerprint_conflicts"},
        "ordering": {"const": "canonical_semantic_json"},
        "global_registry": {"const": false},
        "historical_interpretation": {"const": "retain_required_exact_versions"}
      },
      "additionalProperties": false
    },
    "contract_identity_policy": {
      "type": "object",
      "required": ["entity_and_relationship_identity", "mode", "supplied_identity", "create", "update", "reference", "composition", "forbidden_derivations"],
      "properties": {
        "entity_and_relationship_identity": {"const": "identity_bearing"},
        "mode": {"const": "canonical_uuidv7"},
        "supplied_identity": {"const": "preserve"},
        "create": {"const": "may_mint_when_absent_without_admission"},
        "update": {"const": "preserve"},
        "reference": {"const": "reuse"},
        "composition": {"const": "does_not_manufacture"},
        "forbidden_derivations": {"const": ["alias", "prose", "path", "hash", "source_location", "ordering", "composition_position"]}
      },
      "additionalProperties": false
    },
    "contract_alias_policy": {
      "type": "object",
      "required": ["fields", "orientation", "allocation", "reservation", "foreign_keys"],
      "properties": {
        "fields": {"const": ["alias_id", "alias_name"]},
        "orientation": {"const": "alias_id_stable_name_descriptive"},
        "allocation": {"const": "consumer_authority"},
        "reservation": {"const": "outside_construction"},
        "foreign_keys": {"const": "aliases_never_canonical"}
      },
      "additionalProperties": false
    },
    "contract_field_policy": {
      "type": "object",
      "required": ["required_optional_forbidden", "unknown_fields", "value_domain", "nested_objects", "determinism"],
      "properties": {
        "required_optional_forbidden": {"const": "exact_contract_declared_sets"},
        "unknown_fields": {"const": "reject"},
        "value_domain": {"const": "string_integer_number_boolean_and_bounded_arrays"},
        "nested_objects": {"const": "forbidden_as_generic_semantic_values"},
        "determinism": {"const": "closed_types_and_explicit_constraints"}
      },
      "additionalProperties": false
    },
    "contract_composition_policy": {
      "type": "object",
      "required": ["parent_constraint", "allowed_parents", "identity_effect", "admission_effect"],
      "properties": {
        "parent_constraint": {"const": "exact_contract_declared"},
        "allowed_parents": {"const": ["adr/logical", "adr/physical-system", "adr/physical-component"]},
        "identity_effect": {"const": "does_not_manufacture_identity"},
        "admission_effect": {"const": "does_not_imply_governance_admission"}
      },
      "additionalProperties": false
    },
    "contract_relationship_policy": {
      "type": "object",
      "required": ["mode", "existence", "endpoint_universe", "endpoint_legality", "properties", "inverse_inference", "identity"],
      "properties": {
        "mode": {"const": "custom_explicit"},
        "existence": {"const": "explicit_relationship_request"},
        "endpoint_universe": {"const": ["canonical_entity", "qualified_custom_type"]},
        "endpoint_legality": {"const": "exact_custom_contract_declared_source_and_target_types"},
        "properties": {"const": "never_implies_graph_relationship"},
        "inverse_inference": {"const": "forbidden_without_declared_inverse"},
        "identity": {"const": "canonical_uuidv7"}
      },
      "additionalProperties": false
    },
    "contract_operation_policy": {
      "type": "object",
      "required": ["create", "update", "reference", "retire", "execution"],
      "properties": {
        "create": {"$ref": "#/$defs/operation_rule"},
        "update": {"$ref": "#/$defs/operation_rule"},
        "reference": {"$ref": "#/$defs/operation_rule"},
        "retire": {"$ref": "#/$defs/operation_rule"},
        "execution": {"const": "not_implemented_in_contract_definition_slice"}
      },
      "additionalProperties": false
    },
    "operation_rule": {
      "type": "object",
      "required": ["permission", "qualification", "persistence", "admission", "alias_reservation", "rules"],
      "properties": {
        "permission": {"enum": ["qualified_contract_required", "read_only_reference"]},
        "qualification": {"const": "exact_type_version_fingerprint"},
        "persistence": {"const": "not_authorized"},
        "admission": {"const": "not_authorized"},
        "alias_reservation": {"const": "not_authorized"},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "migration_policy": {
      "type": "object",
      "required": ["mode", "source", "target", "identity", "field_changes", "relationship_disposition", "aliases", "ambient_replacement"],
      "properties": {
        "mode": {"const": "explicit_contract_migration"},
        "source": {"const": "exact_type_version_fingerprint"},
        "target": {"const": "exact_type_version_fingerprint"},
        "identity": {"const": "same_architectural_referent_preserves_uuidv7"},
        "field_changes": {"const": "explicitly_qualified"},
        "relationship_disposition": {"const": "explicitly_declared"},
        "aliases": {"const": "governed_changes_retain_provenance"},
        "ambient_replacement": {"const": false}
      },
      "additionalProperties": false
    },
    "promotion_policy": {
      "type": "object",
      "required": ["mode", "same_referent_identity", "relationships", "field_migration", "aliases", "recreation"],
      "properties": {
        "mode": {"const": "future_explicit_canonical_promotion"},
        "same_referent_identity": {"const": "preserve_uuidv7"},
        "relationships": {"const": "compatible_relationships_should_be_preserved"},
        "field_migration": {"const": "explicit_contract_qualified"},
        "aliases": {"const": "may_evolve_with_provenance"},
        "recreation": {"const": false}
      },
      "additionalProperties": false
    },
    "read_only_boundary": {
      "type": "object",
      "required": ["descriptive_only", "construct_authoring_set", "validate_authoring", "custom_operations", "registry_execution", "persistence", "runtime", "capability_advertisement"],
      "properties": {
        "descriptive_only": {"const": true},
        "construct_authoring_set": {"const": false},
        "validate_authoring": {"const": false},
        "custom_operations": {"const": false},
        "registry_execution": {"const": false},
        "persistence": {"const": false},
        "runtime": {"const": false},
        "capability_advertisement": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
