{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/implementation-attribution-evidence.schema.json",
  "title": "Implementation Attribution Evidence Schema",
  "type": "object",
  "required": ["schema_version", "type", "records"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.2"]
    },
    "type": {"const": "implementation_attribution_evidence"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "implementation_entity_id",
          "implementation_entity_type",
          "attributed_adrs",
          "enforced_invariants",
          "provenance"
        ],
        "properties": {
          "implementation_entity_id": {"type": "string"},
          "implementation_entity_type": {
            "type": "string",
            "enum": [
              "function",
              "class",
              "module",
              "service",
              "workflow",
              "infrastructure_template",
              "configuration_file",
              "schema_definition",
              "pipeline",
              "script",
              "data_model"
            ]
          },
          "attributed_adrs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "enforced_invariants": {
            "type": "array",
            "items": {"type": "string"}
          },
          "provenance": {
            "type": "object",
            "required": ["source_file", "extractor"],
            "properties": {
              "source_file": {"type": "string"},
              "extractor": {"type": "string"},
              "commit": {"type": ["string", "null"]}
            }
          },
          "metadata": {"type": "object"},
          "confidence": {
            "type": "string",
            "enum": ["declared", "inferred", "heuristic"]
          },
          "attributed_capabilities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "attribution_source_language": {
            "type": "string",
            "enum": ["python", "typescript", "cloudformation", "csharp", "unknown"]
          }
        }
      }
    }
  }
}
