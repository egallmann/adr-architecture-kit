{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/authoring/v1.5/adr-physical-component.schema.json",
  "title": "Physical-Component ADR Schema (authoring v1.5)",
  "description": "Schema for Physical-Component ADRs — v1.5 identity model without component_topology",

  "type": "object",
  "allOf": [
    {"$ref": "adr-physical-base.schema.json"}
  ],

  "required": [
    "implements_system",
    "component_specifications"
  ],

  "not": {
    "required": ["component_topology"]
  },

  "properties": {
    "adr_type": {"const": "physical-component"},

    "alias_id": {
      "$ref": "types.schema.json#/definitions/adr_id_physical_component"
    },

    "implements_system": {
      "type": "array",
      "items": {"$ref": "types.schema.json#/definitions/uuid_v7"},
      "minItems": 1
    },

    "component_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{"$ref": "adr-common.schema.json#/definitions/identity_envelope"}],
        "required": ["id", "alias_id", "alias_name", "name", "type", "responsibilities", "generation_context"],
        "properties": {
          "id": {"$ref": "types.schema.json#/definitions/uuid_v7"},
          "alias_id": {"$ref": "types.schema.json#/definitions/entity_id", "pattern": "^COMP-[0-9]{4}$"},
          "alias_name": {"$ref": "types.schema.json#/definitions/alias_name"},
          "name": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["service", "library", "database", "queue", "cache", "gateway", "proxy", "worker", "scheduler"]
          },
          "responsibilities": {"$ref": "types.schema.json#/definitions/markdown_text"},
          "generation_context": {
            "type": "object",
            "required": ["purpose", "key_responsibilities"],
            "properties": {
              "purpose": {"type": "string"},
              "key_responsibilities": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              },
              "constraints": {"type": "array", "items": {"type": "string"}},
              "success_criteria": {"type": "array", "items": {"type": "string"}}
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [{"$ref": "adr-common.schema.json#/definitions/identity_envelope"}],
              "required": ["id", "alias_id", "alias_name", "type", "specification"],
              "properties": {
                "id": {"$ref": "types.schema.json#/definitions/uuid_v7"},
                "alias_id": {"$ref": "types.schema.json#/definitions/entity_id", "pattern": "^IFACE-[0-9]{4}$"},
                "alias_name": {"$ref": "types.schema.json#/definitions/alias_name"},
                "type": {
                  "type": "string",
                  "enum": ["REST", "gRPC", "GraphQL", "message", "event", "stream", "batch", "CLI", "library_api"]
                },
                "specification": {"$ref": "types.schema.json#/definitions/markdown_text"}
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
