{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.ste.systems/contracts/architecture-interpretation/v1.3/resources/conformance.schema.json",
  "title": "Architecture Interpretation 1.3 frozen normative conformance schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "semanticDependencies",
    "source_contract",
    "output_contract",
    "frozen_conformance_schema",
    "cases"
  ],
  "properties": {
    "resource": {
      "const": "architecture-interpretation/1.3/conformance"
    },
    "semanticDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_contract": {
      "const": "authoring@1.7"
    },
    "output_contract": {
      "const": "normalized-model@2.5"
    },
    "frozen_conformance_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "expected_values",
        "authority_only",
        "not_acc_execution"
      ],
      "properties": {
        "required": {
          "const": [
            "id",
            "assertion",
            "expected"
          ]
        },
        "expected_values": {
          "const": [
            "conforms",
            "rejects",
            "preserves",
            "excludes",
            "matches"
          ]
        },
        "authority_only": {
          "const": true
        },
        "not_acc_execution": {
          "const": true
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assertion",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AI13-[0-9]{3}$"
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "conforms",
              "rejects",
              "preserves",
              "excludes",
              "matches"
            ]
          },
          "category": {
            "enum": [
              "inherited-requalified",
              "root-lifecycle",
              "schema-ownership",
              "successor-authority"
            ]
          },
          "requalified_from": {
            "type": "string",
            "pattern": "^AI12-[0-9]{3}$"
          },
          "rule_id": {
            "enum": [
              "declaring-lifecycle.adr-logical.architectural_boundaries",
              "declaring-lifecycle.adr-logical.capabilities",
              "declaring-lifecycle.adr-logical.contracts",
              "declaring-lifecycle.adr-logical.decisions",
              "declaring-lifecycle.adr-logical.evidence_expectations",
              "declaring-lifecycle.adr-logical.gaps",
              "declaring-lifecycle.adr-logical.invariants",
              "declaring-lifecycle.adr-physical-component.component_specifications",
              "declaring-lifecycle.adr-physical-component.component_specifications.interfaces",
              "declaring-lifecycle.adr-physical-component.evidence_expectations",
              "declaring-lifecycle.adr-physical-component.gaps",
              "declaring-lifecycle.adr-physical-component.implementation_decisions",
              "declaring-lifecycle.adr-physical-system.data_flows",
              "declaring-lifecycle.adr-physical-system.evidence_expectations",
              "declaring-lifecycle.adr-physical-system.gaps",
              "declaring-lifecycle.adr-physical-system.system",
              "declaring-lifecycle.adr-physical-system.system_boundaries"
            ]
          }
        }
      }
    }
  }
}
