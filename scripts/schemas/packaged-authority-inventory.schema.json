{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adr-kit:governance-design:packaged-authority-inventory:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_commit",
    "artifacts",
    "authorities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "packaged-semantic-authority-inventory"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "version",
          "scf",
          "resources",
          "placements",
          "disposition"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "scf": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "digest"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact",
                "locator",
                "digest",
                "encoding"
              ],
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "encoding": {
                  "enum": [
                    "json",
                    "embedded-wasm",
                    "schema",
                    "resource-qualified"
                  ]
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "disposition": {
            "enum": [
              "released",
              "independently_promoted",
              "candidate"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
