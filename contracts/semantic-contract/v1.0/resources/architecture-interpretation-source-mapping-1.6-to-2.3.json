  "fields": {"type": "source-adr-type-or-np-discriminator", "lifecycle": "declaring-adr-only; np-has-no-independent-lifecycle", "provenance": "source-locator-and-contract-binding", "declaringParent": "required-for-normative-proposition", "normativeForce": "preserve-explicit-canonical-force", "scope": "preserve-or-report-unknown", "rationale": "preserve-explicit-source-rationale", "relationships": "explicit-source-relationship-or-unresolved-reference", "ownership": "explicit-declaring-parent-only"},
