    "./validation": ["assertValidContract", "validateAuthoringDocument", "validateContract", "ValidationResult", "AuthoringAdrType", "AuthoringValidationMode"],
    "./node": ["openRepository", "validateContract", "materializeArchitecture", "ArchitectureRepository", "ContractValidationRequest", "ContractValidationResult", "RepositoryError", "RepositoryPathError", "AmbiguousAliasError", "ArchitectureMaterializationRequest", "ArchitectureMaterializationResult", "MaterializationAuthorityProvider", "MaterializationCapabilityLimitation", "MaterializationProviderProvenance", "MaterializationSemanticBasis", "MaterializationSourceArtifact", "MaterializationSourceBasis", "MaterializationSourceContract"],
