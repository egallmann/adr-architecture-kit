{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adr-kit.ste.systems/schema/v1.1/relationship-registry.schema.json",
  "title": "Relationship Registry Schema",
  "type": "object",
  "required": ["schema_version", "type", "relationships"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "type": {"const": "relationship_registry"},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_id", "relationship_type", "from_entity_id", "to_entity_id", "provenance_classification", "evidence", "canonical_source_ref", "confidence"],
        "properties": {
          "relationship_id": {"type": "string"},
          "assertion_id": {"type": "string", "pattern": "^asrt-[0-9a-f]{64}$"},
          "relationship_type": {
            "type": "string",
            "enum": ["declared_in", "declares", "references", "referenced_by", "related_to", "enforces", "enforced_by", "enabled_by", "enables", "governs", "governed_by", "implemented_by", "implements", "embodied_in", "embodies", "supersedes", "superseded_by", "refines", "refined_by", "provides_interface", "composed_of", "binds_substrate", "binds_rule", "expects_evidence"]
          },
          "from_entity_id": {"type": "string"},
          "to_entity_id": {"type": "string"},
          "provenance_classification": {
            "type": "string",
            "enum": ["explicit", "derived", "heuristic"]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "canonical_source_ref": {"type": "string"},
          "source_pointer": {"type": ["string", "null"]},
          "confidence": {"type": "number"},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
