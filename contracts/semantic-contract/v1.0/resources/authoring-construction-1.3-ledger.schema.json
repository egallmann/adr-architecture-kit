{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/semantic-contract/resources/authoring-construction/1.3/ledger.schema.json",
  "title": "ACC 1.3 whole-result semantic ledger",
  "type": "object",
  "required": [
    "ledger_version",
    "semantic_units",
    "relationships",
    "unresolved"
  ],
  "properties": {
    "ledger_version": {
      "const": "authoring-construction-semantic-ledger/1.3"
    },
    "semantic_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_unit"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "identity_kind",
        "components"
      ],
      "properties": {
        "identity_kind": {
          "enum": [
            "canonical_uuidv7",
            "topology_owner_key",
            "ai13_semantic_tuple"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {}
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "semantic_field_key",
        "value"
      ],
      "properties": {
        "semantic_field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_-]*#(?:/(?:[^~/]|~[01])*)*$"
        },
        "value": {},
        "ordering": {
          "enum": [
            "unordered_set",
            "unordered_multiset",
            "ordered_sequence",
            "scalar_or_object"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "semantic_field_key": {
                "const": "context/declaring_adr_lifecycle#"
              }
            },
            "required": [
              "semantic_field_key"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/contextual_lifecycle_fact"
              }
            }
          }
        }
      ]
    },
    "semantic_unit": {
      "type": "object",
      "required": [
        "semantic_type",
        "identity",
        "fields"
      ],
      "properties": {
        "semantic_type": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "lifecycle_stage": {
          "enum": [
            "accepted",
            "deprecated",
            "proposed",
            "superseded"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "fields": {
                "contains": {
                  "properties": {
                    "semantic_field_key": {
                      "const": "context/declaring_adr_lifecycle#"
                    }
                  },
                  "required": [
                    "semantic_field_key"
                  ]
                }
              }
            },
            "required": [
              "fields"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "lifecycle_stage"
                ],
                "properties": {
                  "semantic_type": {
                    "enum": [
                      "entity/boundary",
                      "entity/capability",
                      "entity/component",
                      "entity/contract",
                      "entity/data_flow",
                      "entity/decision",
                      "entity/evidence_expectation",
                      "entity/gap",
                      "entity/implementation_decision",
                      "entity/interface",
                      "entity/invariant",
                      "entity/system",
                      "entity/system_boundary"
                    ]
                  },
                  "identity": {
                    "properties": {
                      "identity_kind": {
                        "const": "canonical_uuidv7"
                      },
                      "components": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        }
                      }
                    }
                  },
                  "fields": {
                    "contains": {
                      "properties": {
                        "semantic_field_key": {
                          "const": "context/declaring_adr_lifecycle#"
                        }
                      },
                      "required": [
                        "semantic_field_key"
                      ]
                    },
                    "minContains": 1,
                    "maxContains": 1,
                    "not": {
                      "contains": {
                        "properties": {
                          "semantic_field_key": {
                            "enum": [
                              "adr/logical#/status",
                              "adr/physical-system#/status",
                              "adr/physical-component#/status"
                            ]
                          }
                        },
                        "required": [
                          "semantic_field_key"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "lifecycle_stage"
                  ]
                },
                "properties": {
                  "identity": {
                    "properties": {
                      "identity_kind": {
                        "const": "canonical_uuidv7"
                      },
                      "components": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        }
                      }
                    }
                  },
                  "semantic_type": {
                    "enum": [
                      "adr/physical-system",
                      "entity/system"
                    ]
                  },
                  "fields": {
                    "allOf": [
                      {
                        "contains": {
                          "properties": {
                            "semantic_field_key": {
                              "const": "context/declaring_adr_lifecycle#"
                            }
                          },
                          "required": [
                            "semantic_field_key"
                          ]
                        },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": {
                          "properties": {
                            "semantic_field_key": {
                              "const": "context/declaring_adr_lifecycle#"
                            },
                            "value": {
                              "properties": {
                                "declaring_adr_semantic_type": {
                                  "const": "adr/physical-system"
                                },
                                "status_semantic_field_key": {
                                  "const": "adr/physical-system#/status"
                                },
                                "ownership_rule": {
                                  "properties": {
                                    "rule_id": {
                                      "const": "declaring-lifecycle.adr-physical-system.system"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "required": [
                            "semantic_field_key",
                            "value"
                          ]
                        },
                        "minContains": 1,
                        "maxContains": 1
                      },
                      {
                        "contains": {
                          "properties": {
                            "semantic_field_key": {
                              "const": "adr/physical-system#/status"
                            },
                            "value": {
                              "enum": [
                                "accepted",
                                "deprecated",
                                "proposed",
                                "superseded"
                              ]
                            }
                          },
                          "required": [
                            "semantic_field_key",
                            "value"
                          ]
                        },
                        "minContains": 1,
                        "maxContains": 1
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "lifecycle_stage"
            ]
          },
          "then": {
            "required": [
              "lifecycle_stage"
            ],
            "properties": {
              "semantic_type": {
                "enum": [
                  "entity/boundary",
                  "entity/capability",
                  "entity/component",
                  "entity/contract",
                  "entity/data_flow",
                  "entity/decision",
                  "entity/evidence_expectation",
                  "entity/gap",
                  "entity/implementation_decision",
                  "entity/interface",
                  "entity/invariant",
                  "entity/system",
                  "entity/system_boundary"
                ]
              },
              "identity": {
                "properties": {
                  "identity_kind": {
                    "const": "canonical_uuidv7"
                  },
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  }
                }
              },
              "fields": {
                "contains": {
                  "properties": {
                    "semantic_field_key": {
                      "const": "context/declaring_adr_lifecycle#"
                    }
                  },
                  "required": [
                    "semantic_field_key"
                  ]
                },
                "minContains": 1,
                "maxContains": 1,
                "not": {
                  "contains": {
                    "properties": {
                      "semantic_field_key": {
                        "enum": [
                          "adr/logical#/status",
                          "adr/physical-system#/status",
                          "adr/physical-component#/status"
                        ]
                      }
                    },
                    "required": [
                      "semantic_field_key"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "required": [
        "relationship_class",
        "identity",
        "relationship_type",
        "from_identity",
        "to_identity",
        "semantic_properties",
        "multiplicity"
      ],
      "properties": {
        "relationship_class": {
          "enum": [
            "canonical",
            "custom_qualified",
            "topology",
            "composition_derived",
            "compatibility_projection"
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1
        },
        "from_identity": {
          "$ref": "#/$defs/identity"
        },
        "to_identity": {
          "$ref": "#/$defs/identity"
        },
        "qualification": {
          "type": [
            "object",
            "null"
          ]
        },
        "semantic_properties": {
          "type": "object"
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": [
        "unresolved_kind",
        "semantic_identity",
        "expected_target",
        "reason_code"
      ],
      "properties": {
        "unresolved_kind": {
          "type": "string",
          "minLength": 1
        },
        "semantic_identity": {
          "$ref": "#/$defs/identity"
        },
        "expected_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]+$"
        }
      },
      "additionalProperties": false
    },
    "contextual_lifecycle_fact": {
      "type": "object",
      "required": [
        "declaring_adr_id",
        "declaring_adr_semantic_type",
        "status_semantic_field_key",
        "ownership_rule"
      ],
      "properties": {
        "declaring_adr_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "declaring_adr_semantic_type": {
          "enum": [
            "adr/logical",
            "adr/physical-system",
            "adr/physical-component"
          ]
        },
        "status_semantic_field_key": {
          "enum": [
            "adr/logical#/status",
            "adr/physical-system#/status",
            "adr/physical-component#/status"
          ]
        },
        "ownership_rule": {
          "type": "object",
          "required": [
            "rule_id"
          ],
          "additionalProperties": false,
          "properties": {
            "rule_id": {
              "enum": [
                "declaring-lifecycle.adr-logical.architectural_boundaries",
                "declaring-lifecycle.adr-logical.capabilities",
                "declaring-lifecycle.adr-logical.contracts",
                "declaring-lifecycle.adr-logical.decisions",
                "declaring-lifecycle.adr-logical.evidence_expectations",
                "declaring-lifecycle.adr-logical.gaps",
                "declaring-lifecycle.adr-logical.invariants",
                "declaring-lifecycle.adr-physical-component.component_specifications",
                "declaring-lifecycle.adr-physical-component.component_specifications.interfaces",
                "declaring-lifecycle.adr-physical-component.evidence_expectations",
                "declaring-lifecycle.adr-physical-component.gaps",
                "declaring-lifecycle.adr-physical-component.implementation_decisions",
                "declaring-lifecycle.adr-physical-system.data_flows",
                "declaring-lifecycle.adr-physical-system.evidence_expectations",
                "declaring-lifecycle.adr-physical-system.gaps",
                "declaring-lifecycle.adr-physical-system.system",
                "declaring-lifecycle.adr-physical-system.system_boundaries"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "semanticDependencies": [
    "architecture-interpretation/1.3/contextual-facts",
    "architecture-interpretation/1.3/lifecycle-provenance.schema",
    "architecture-interpretation/1.3/lifecycle-ownership",
    "normalized-model/2.5/schema/normalized-entity.schema"
  ]
}
