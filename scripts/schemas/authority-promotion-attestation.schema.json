{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adr-kit:governance-design:authority-promotion-attestation:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_commit",
    "qualification",
    "retained_bundle",
    "artifacts",
    "approved_authorities",
    "human_approval",
    "publication_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "semantic-authority-promotion-attestation"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "ref",
        "event",
        "run_id",
        "workflow_path",
        "conclusion"
      ],
      "properties": {
        "repository": {
          "const": "egallmann/adr-architecture-kit"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "const": "refs/heads/main"
        },
        "event": {
          "const": "push"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_path": {
          "const": ".github/workflows/release-certification.yml"
        },
        "conclusion": {
          "const": "success"
        }
      }
    },
    "retained_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "manifest_digest",
        "inventory_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "version",
          "scf",
          "resources",
          "placements",
          "disposition"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "scf": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^scf:v1:sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "digest"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact",
                "locator",
                "digest",
                "encoding"
              ],
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "encoding": {
                  "enum": [
                    "json",
                    "embedded-wasm",
                    "schema",
                    "resource-qualified"
                  ]
                }
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "disposition": {
            "enum": [
              "released",
              "independently_promoted",
              "candidate"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "evidence_url",
        "actor",
        "reviewed_source_commit"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github-approved-review",
            "protected-human-environment"
          ]
        },
        "evidence_url": {
          "type": "string",
          "pattern": "^https://github.com/egallmann/adr-architecture-kit/"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "publication_mode": {
      "const": "promote-retained-payloads-only"
    }
  }
}
