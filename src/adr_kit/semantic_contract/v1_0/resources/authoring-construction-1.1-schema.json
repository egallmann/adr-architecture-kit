      "type": "object",
      "required": [
        "status",
        "code",
        "mismatch_kind"
      ],
      "properties": {
        "status": {
          "enum": [
            "violation",
            "blocked",
            "unresolved",
            "unavailable"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^authoring_construction\\.[a-z0-9_.-]+$"
        },
        "mismatch_kind": {
          "enum": [
            "missing_expected_semantic",
            "unexpected_observed_semantic",
            "conflicting_semantic_value",
            "multiplicity_mismatch",
            "identity_mismatch",
            "unclassified_semantic_field",
            "ambiguous_match",
            "interpretation_incomplete",
            "normalized_model_invalid",
            "unresolved_reference",
            "authority_unavailable"
          ]
        },
        "semantic_unit_identity": {
          "$ref": "ledger.schema.json#/$defs/identity"
        },
        "semantic_field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_-]*#(?:/(?:[^~/]|~[01])*)*$"
        },
        "relationship_identity": {
          "$ref": "ledger.schema.json#/$defs/identity"
        },
        "expected_present": {
          "type": "boolean"
        },
        "observed_present": {
          "type": "boolean"
        },
        "source_instance_pointer": {
          "type": "string",
          "minLength": 1
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "exact_ai12_closure": {
      "type": "object",
      "required": [
        "family",
        "version",
        "resources"
      ],
      "properties": {
        "family": {
          "const": "architecture-interpretation"
        },
        "version": {
          "const": "1.2"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
