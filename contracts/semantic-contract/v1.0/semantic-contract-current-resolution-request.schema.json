{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/contracts/semantic-contract/v1.0/semantic-contract-current-resolution-request.schema.json",
  "title": "ADR-Kit current semantic-contract resolution request v1.0",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "operation", "direction", "current", "definitions", "sets", "qualifications", "catalog", "policy"],
  "properties": {"profile": {"$ref": "semantic-contract-profile.schema.json"}, "operation": {"type": "string", "minLength": 1}, "direction": {"enum": ["none", "forward", "reverse"]}, "current": {"$ref": "semantic-contract-current-selection.schema.json"}, "definitions": {"type": "array"}, "sets": {"type": "array", "items": {"$ref": "semantic-contract-set.schema.json"}}, "qualifications": {"type": "array", "items": {"$ref": "semantic-contract-qualification.schema.json"}}, "catalog": {"$ref": "semantic-contract-catalog.schema.json"}, "policy": {"$ref": "semantic-contract-policy.schema.json"}}
}
